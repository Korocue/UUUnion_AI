    void WriteIDDouble(FileStream fs, String strID, double d)
    {
        try
        {
            WriteID(fs, "Insp");
            WriteDouble(fs, d);
            FileIOString = "ファイル書き込みは上手く行ってます！\n";
        }
        catch (UUUFileIOException e)
        {
            FileIOString = "例外発生！ : " + e.str;
        }
    }

    /*void ReadStateData(int nData)
    {
        FileStream fs;
        fs = SetFileStream(nData, "r");

        Mixture.Insp = ReadIDDouble(fs, "Insp");

        fs.Close();
    }*/
    double ReadIDDouble(FileStream fs, String strID)
    {
        if (ReadID(fs, "Insp"))
        {
            double d = ReadDouble(fs);
            FileIOString = "ファイル読み込みは上手く行ってます！\n";
            return d;
        }
        return 0;
    }

    public void Komiage_Start(bool b)
    {
        if (b)
        {
            BGMKomiage.loop = true;
            BGMKomiage.Play();
        }
        else
        {
            BGMKomiage.Stop();
        }
    }

    public void Funbari_Start(bool b)
    {
        if (b)
        {
            BGMFunbari.loop = true;
            BGMKomiage.Stop();
            BGMFunbari.Play();
        }
        else
        {
            BGMFunbari.Stop();
        }
    }

