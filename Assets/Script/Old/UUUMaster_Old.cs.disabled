        if (TimetoSpawnFlavor < 0)
        {
            SpawnFlavor();
            TimetoSpawnFlavor = 300.0f + 180 * Random.value;    // フレーバー出現時間（5m - 8m）
        }
#endif

        UpdateDebugText();
    }

    void UpdateInit()
    {
        dbg(0, 2, "■Union");

        // アプデ毎に1回読まないと大変なことになる
        if (DTimeChecker == null) DTimeChecker = new();
        dTime = DTimeChecker.GetDeltaTime();
        dbg(0, 4, "dTime = " + dTime.ToString("F4"));
        dbg(0, 5, "IngameTime = " + DTimeChecker.IngameTime.ToString("F4"));
        dbg(0, 6, "LastIngameTime = " + DTimeChecker.LastIngameTime.ToString("F4"));

        // トレース用in-gameタイム
        if (ModeTrace)
        {
            dTime = 0;
            dbg(0, 3, "トレースモード！");
        }
        else
        {
            dbg(0, 3, "通常通りに時間が流れています……");
            //dTime = Time.deltaTime;    
        }
        // カクツキが発生した場合にブレークポイントを設定する
        if (dTime > 1.0f / 15)
        {
            dTime = 1.0f / 15;
            // 15fps以上で極端な数字は丸める
        }

        IngameTime += dTime;
        frameTime += 1.0f / 60;
        //dTime = 1.0f / 60;
    }

