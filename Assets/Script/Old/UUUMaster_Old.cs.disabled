    FileStream SetFileStream(int nData, String str)
    {
        FileStream fs;
        String path = "UUUState" + nData.ToString("F0") + ".uuu";

        FileIOString = "ファイル読み込みエラー！\n";
        if (str == "w")
        {
            return File.Open(path, FileMode.OpenOrCreate);
        }

        return File.Open(path, FileMode.Open);
    }

    // ■ステートデータへのアクセス
    // 読み込みと書き込みに両方対応しているので
    // ここを書き換えるだけでセーブデータの形式を変更できる
    public void AccessStateData(int nData, String rw)
    {
        FileStream fs;
        fs = SetFileStream(nData, rw);

        string strVer = UUUFileBuildVersion.str;

        AccessVersion(fs, ref strVer, rw);
        // バージョン情報の読み込み／書き込み

        if (strVer == "UUUnionb52")
        {
            AccessIDDouble(fs, "Insp", ref tu.mt.Insp, rw);
            AccessIDDouble(fs, "InspMinus", ref tu.mt.InspMinus, rw);
            AccessIDDouble(fs, "Insp2", ref tu.mt.Insp2, rw);
            AccessIDDouble(fs, "Insp3", ref tu.mt.Insp3, rw);
            AccessIDDouble(fs, "Mix", ref tu.mt.Mix, rw);
            AccessIDDouble(fs, "dMix", ref tu.mt.dMix, rw);
            AccessIDDouble(fs, "Irk", ref tu.mt.Irk, rw);
            AccessIDDouble(fs, "Prod", ref tu.mt.Product, rw);
            AccessIDDouble(fs, "dProd", ref tu.mt.dProduct, rw);
            AccessIDDouble(fs, "Sukkiri", ref tu.mt.Sukkiri, rw);
            AccessIDDouble(fs, "dSukkiri", ref tu.mt.dSukkiri, rw);
            AccessIDDouble(fs, "Tamaran_Insp", ref tu.mt.Tamaran_Insp, rw);
            AccessIDDouble(fs, "Tamaran_A", ref tu.mt.Tamaran_A, rw);
            AccessIDDouble(fs, "MaxKomiage", ref tu.mt.MaxKomiage, rw);
            AccessIDDouble(fs, "MaxKomiageRate", ref tu.mt.MaxKomiageRate, rw);
            AccessIDDouble(fs, "Komiage", ref tu.mt.Komiage, rw);
            AccessIDDouble(fs, "Haki", ref tu.mt.Haki, rw);
            AccessIDDouble(fs, "Haki_Rate", ref tu.mt.Haki_Rate, rw);
            AccessIDDouble(fs, "Haki_Komi", ref tu.mt.Haki_Komi, rw);
        }

        fs.Close();
    }

    void AccessVersion(FileStream fs, ref String verID, String rw)
    {
        // Version表記はファイルの一番最初に
        // ID + ビルドバージョンの組み合わせで記述する
        // （例 : "IWannaUnionWithFilexxxxUUUnionb52"）
        //
        // これは今後の全バージョンで共通にすることで
        // 以降のファイル形式の変更で多少の互換性を持たせる予定

        if (rw == "w")
        {
            WriteString(fs, UUUFileBuildVersion.id);
            WriteDouble(fs, UUUFileBuildVersion.str.Length);
            // double型で文字長を書き込む
            WriteString(fs, UUUFileBuildVersion.str);
        }
        if (rw == "r")
        {
            if (ReadString(fs, UUUFileBuildVersion.id.Length) == UUUFileBuildVersion.id)
            {
                int length = (int)ReadDouble(fs);
                // double型で読み込んだ文字長をint型に変換する
                verID = ReadString(fs, length);
            }
        }
    }

    // 参照を使ってdを書き込むか、dに読み込む
    void AccessIDDouble(FileStream fs, String strID, ref double d, String rw)
    {
        if (rw == "w")
        {
            WriteIDDouble(fs, strID, d);
        }
        if (rw == "r")
        {
            d = ReadIDDouble(fs, strID);
        }
        //Mixture.FileIOString = "AccessIDDoubleは処理されてます！\n";
    }

