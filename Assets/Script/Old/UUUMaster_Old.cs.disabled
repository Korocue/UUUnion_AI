        // ステージ4 : こみ上げ値が2%でバクハツ状態
        // ステージ3 : インスピ2値90% or たまらん値50%
        // ステージ2 : インスピ1値80% or インスピ2値20%
        // ステージ1 : インスピ0値50% or インスピ1値10%
        if (Mixture.dProduct / Mixture.Iroduki_Limit > 0.02f)
        {
