                        Mixture.DoMix();
                        ms_LastInsp = IngameTime;
                    }
                }
            }
            // 条件が複雑
            // オートインスピ解除後のインスピ解除用
            else if (mix_keydown_m == 0 &&
                (mix_keydown == 1 || (automix == 0 && ms_LastInsp < IngameTime - 0.3)))
            {
                mix_keydown = 0;
                Anm_Union.SetTrigger("Insp_return");
