        // (Mixture.Insp_Rate(Mixture.Taraman) > 0.8f)
        //|| Mixture.Insp_Rate(Mixture.Insp2) >= 0.2f)
        //else if (Mixture.Iroduki / Mixture.Iroduki_Limit > 0.5f
        //    || Mixture.Insp / Mixture.Insp_Limit > 0.8f
        //    || Mixture.Komiage / Mixture.Insp_Limit > 0.01f)
        {
            if (gaman_state != 2)
            {
                Anm_Union.SetInteger("Gaman_State", 2);
                Anm_Union.SetTrigger("Gaman_State_Changed");
                gaman_state = 2;
            }
        }
        else if (Mixture.Insp_Rate(Mixture.InspVolume()) > 0.5f)
        // (Mixture.Insp_Rate(Mixture.Tamaran) > 0.5f)
        //|| Mixture.Insp_Rate(Mixture.Insp1) >= 0.1f)
