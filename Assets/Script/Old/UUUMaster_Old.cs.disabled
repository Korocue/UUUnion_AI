    // デバッグ中にデバッグテキストが消滅するのでチェック
    public void CheckDebugArray()
    {
        if (DTArray == null)
        {
            DTArray = new string[100, 100];
        }
    }

    public void UpdateDebugText()
    {
        double flavor0 = 0;

        /*
        if (Fl.Count() != 0)
        {
            flavor0 = mt.Fl(0).value;
        }*/

        int page = 0;
        int i = 0;
        StringBuilder sb = new StringBuilder("\n\n\n\n== Debug Informations " + "(" + (DTPage + 1).ToString("D0") + "/" + "100" + ")" + " ==" + "\n");

        foreach (string str in DTArray)
        {
            if (page == DTPage)
            {
                sb.Append("[" + i.ToString("D2") + "]");
                sb.Append(str);
                sb.Append("\n");
            }
            i++;
            if (i >= 100)
            {
                i = 0;
                page++;
            }
        }
        DebugText2.text = sb.ToString();
    }
    public void dbg(int page, int i, string str)
    {
        DTArray[page, i] = str;
    }
}