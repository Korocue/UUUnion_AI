                tu.mt.Producing--;
                tu.ProductFlavor_Num--;

                Destroy(tu.ProductFlavors[i]);
                tu.ProductFlavors.Remove(tu.ProductFlavors[i]);
            }
        }

        // 生産ポップ処理
        // 表示時間を過ぎたポップを消去
        for (int i = 0; i < tu.ProdPops.Count; i++)
        {
            if (tu.ProdPops[i].GetComponent<ProdPop>().times < 0)
            {
                Destroy(tu.ProdPops[i]);
                tu.ProdPops.Remove(tu.ProdPops[i]);
            }
        }
#endif
    }

