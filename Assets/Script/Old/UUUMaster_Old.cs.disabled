                    if (r == 2) Sound02_a.Play();
                    if (r == 3) Sound02_b.Play();
                    mix_state = 0;
                    Mixture.DoMix(); // ここでミクスチャを刺激する
                    ms_LastInsp = IngameTime;
                }
            }
            // 条件が複雑
            // オートインスピ解除後のインスピ解除用（中止）
            if (automix == 0 &&
