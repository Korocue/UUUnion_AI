            {
                if (tu.ProductFlavors[i].GetComponent<Product>().Type == "Moti") mt.Produced -= 10.0f;
                if (tu.ProductFlavors[i].GetComponent<Product>().Type == "Whip") mt.Produced -= 1.0f;
