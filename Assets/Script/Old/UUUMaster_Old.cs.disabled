    // Use this for initialization
    void Start()
    {
        // ==== MixController & InputController 初期化 ====
        mixController = new UUUMixController(this);
        inputController = new UUUInputController(this, tu);

        InitBasic();
        InitParam();
        InitSound();
    }
    void InitBasic()
    {
        DTimeChecker = new();
        IngameTime = 0;
        ModeTrace = false;
        Flag_FrameAdv = false;

        TestCode = "Kurimanju";
        BuildVersion = UUUFileBuildVersion.str;
        // ファイル形式が変化したら、UUUFileIO.csでバージョンを変更する

        //DebugText = DebugInfo.GetComponent<Text>();
        //DebugText2 = DebugInfo2.GetComponent<Text>();
        DTArray = new string[100, 100];
        DTPage = 0;
    }
    void InitParam()
    {
        automix = 0;
        manual_automix = 0;

        // irk = 0;
        // irk_automix_time = 5.0f;
        frameTime = 0;
        manual_automix_time = 1.0f;
        // automix_time = manual_automix_time = 1.0f;
        // mix_state = 0;
        // gaman_state = 0;
        // funbari_state = 0;

        // Fl_List_Construct();
        TimetoSpawnFlavor = 1.0f;                            // 300.0f + 180 * Random.value;    // フレーバー出現時間（5m - 8m）

        // ProdPops = new List<GameObject>();                   // 生産ポップ配列初期化
        // ProductItems = new int[50];                          // シロップ９種、ホイップ９種、モチ９種、その他予備
        // for (int i = 0; i < 50; i++) ProductItems[i] = 0;

        Mood = 0;
        OrgMoodColor = Camera.backgroundColor;
        TestTime = 0;
    }
    void InitSound()
    {
        DefVolume_Sound01 = Sound01.volume;
        DefVolume_Sound01_a = Sound01_a.volume;
        DefVolume_Sound01_b = Sound01_b.volume;
        DefVolume_Sound02 = Sound02.volume;
        DefVolume_Sound02_a = Sound02_a.volume;
        DefVolume_Sound02_b = Sound02_b.volume;

        DefVolume_Sound03 = Sound03_a1.volume;
        DefVolume_BGMFunbari = BGMFunbari.volume;
    }

#if b59
    // 仮処理
    // ソースコード変更でListが消滅した場合用
    public void Fl_List_Construct()
    {
        Fl = new Fl_List();
        Fl.Union = this.TargetUnion;
    }
#endif

    // Update is called once per frame
    void Update()
    {

        UpdateInit();

        UpdateProductInfo();
        // UpdateProdAmount();
        UpdateMood();

        inputController.UpdateInputs();

        // ==== MixController 入力処理 ====
        // Fire2 押下状態を MixController に伝える
        float t = IngameTime;

        // ↓ ここが重要ポイント：MixController にパラメータ更新
        mixController.currentManualAutoMixTime = manual_automix_time;
        mixController.currentIrkAutoMixTime = tu.irk_automix_time;

        // irk 値を毎フレーム渡す（Master 内で計算しているなら）
        mixController.currentIrk = tu.irk;

        if (Mix_keydown == 1)
        {
            mixController.OnMixPress(t);
        }
        else
        {
            mixController.OnMixRelease(t);
        }

        // ==== MixController 毎フレーム更新 ====
        mixController.Update(t);

#if Disabled_in_b59
        // ■ファイル入出力(b52)
        // ステートセーブとしてShift - F1-F10でデータセーブ
        // F1-F10でデータを読み込む
        bool isShift = Input.GetKey(KeyCode.LeftShift) || Input.GetKey(KeyCode.RightShift); ;       // シフト入力
        bool isWrite = false;       // 書き込みフラグ 
        int nData = 0;              // データ番号 
        if (Input.GetKeyDown(KeyCode.F1)) nData = 1;
        if (Input.GetKeyDown(KeyCode.F2)) nData = 2;
        if (Input.GetKeyDown(KeyCode.F3)) nData = 3;
        if (Input.GetKeyDown(KeyCode.F4)) nData = 4;
        if (Input.GetKeyDown(KeyCode.F5)) nData = 5;
        if (Input.GetKeyDown(KeyCode.F6)) nData = 6;
        if (Input.GetKeyDown(KeyCode.F7)) nData = 7;
        if (Input.GetKeyDown(KeyCode.F8)) nData = 8;
        if (Input.GetKeyDown(KeyCode.F9)) nData = 9;
        if (Input.GetKeyDown(KeyCode.F10)) nData = 10;

        if (isShift)
        {
            isWrite = true;
        }

        // ファイル入出力
        if (nData != 0)
        {
            if (isWrite)
            {
                // 書き込みモードでアクセス
                AccessStateData(nData, "w");
            }
            else
            {
                // 読み込みモードでアクセス
                AccessStateData(nData, "r");
            }
        }

        // インスピレーション自動化はInspirationで行うべきか
        if (Input.GetKeyDown("q"))  // オートインスピレーションキー(Qキー)
        {
            if (manual_automix == 0)
            {
                manual_automix = 1;
                tu.AutoMix_Start();
                //StartCoroutine("Inspiration");
            }
            else
            {
                manual_automix = 0;
                tu.AutoMix_Stop();
                //Anm_Union.ResetTrigger("Inspiration");
                //Anm_Union.SetTrigger("Insp_return");
                //StopCoroutine("Inspiration");
            }
        }

        // オートインスピレーションキー(Qキー)
        // がまんキー(Enter)
        // デバッグ用Iroduki調整(U)Mixture.Iroduki = 50
        // デバッグ用InspLimit調整(I)Mixture.Insp_Limit = 50
        // デバッグ用Iroduki調整(K)Mixture.Iroduki = 50
        // デバッグ用Insp調整(L)Mixture.Insp = 5
        // デバッグ用Funbari調整(;)Mixture.Funbari = 0
        // ミクスチャキー(左クリック)
        if (TestCode == "Manjutane")
        {
            if (Input.GetButtonDown("Fire2"))  // がまんキー(右クリック)
            {
                tu.mt.Endure(0.5f);
                Endure.Play();
            }
        }
        if (Input.GetKeyDown("g"))  // フレーバー切り替え
        {
            if (tu.Fl.list == null)
            {
                FlavorSpawn.Play();
            }
            if (tu.Fl.list.Count == 0)
            {
                FlavorSpawn.Play();
                tu.Fl.SetFlavor("Kuripon");
            }
            else
            {
                FlavorSpawn.Play();
                if (tu.Fl.list[0].Type == "Kuripon")
                {
                    tu.Fl.DestroyFlavor(tu.Fl.list[0]);
                    tu.Fl.SetFlavor("Pippi");
                }
                else
                {
                    tu.Fl.DestroyFlavor(tu.Fl.list[0]);
                }
            }
        }
        if (Input.GetKeyDown("t"))  // トレースモード切替(T)
        {
            if (!ModeTrace)
            {
                ModeTrace = true;
            }
            else
            {
                ModeTrace = false;
            }
        }
        if (Input.GetKeyDown("y"))  // トレース用コマ送り(Y)
        {
            dTime = 1.0f / 60;
            IngameTime += dTime;
        }
        if (Input.GetKeyDown("u"))  // デバッグ用Tamekomi調整(U)
        {
            tu.mt.Tamekomi = tu.mt.RateToTamekomi(100);
        }
        if (Input.GetKeyDown("i"))  // デバッグ用InspLimit調整(I)
        {
            tu.mt.Insp_Limit = 50;
        }
        if (Input.GetKeyDown("k"))  // デバッグ用がまんレベル調整(K)
        {
            tu.mt.Product += tu.mt.Product * 0.1f;
        }
        if (Input.GetKeyDown("l"))  // デバッグ用がまんレベル調整(L)
        {
            tu.mt.Product -= tu.mt.Product * 0.1f;
        }
        if (Input.GetKeyDown("o"))  // デバッグ用Iroduki調整(O)
        {
            tu.mt.Insp += tu.mt.RateToInsp(1);
        }
        if (Input.GetKeyDown("p"))  // デバッグ用Iroduki調整(P)
        {
            tu.mt.Insp -= tu.mt.RateToInsp(1);
        }
        if (Input.GetKeyDown(KeyCode.Comma))  // 自動インスピレーション間隔(<)
        {
            manual_automix_time /= 1.05f;
        }
        if (Input.GetKeyDown(KeyCode.Period))  // 自動インスピレーション間隔(>)
        {
            manual_automix_time *= 1.05f;
        }
        if (Input.GetKeyDown(KeyCode.Semicolon))  // デバッグ用Funbari調整(;) ※セミコロンのはずが、バグでEqualsになってる？
        {
            tu.mt.Sukkiri = 0;
        }
        if (Input.GetKeyDown("space"))  // ミクスチャ非表示切り替え
        {
            tu.mt.ui.Visible = !tu.mt.ui.Visible;
        }

        // デバッグ表示切替
        // ①デバッグ情報1(ミクスチャ情報), ②:デバッグ情報2, ③生産物情報
        // スラッシュとバックスラッシュ
        // キーコードがどこにも載っていないので
        // このデバッグ機能で取得したキーコード161を使用する
        if (Input.GetKeyDown(KeyCode.Slash))  // 後方切り替え
        {
            if (DebugText.enabled)
            {
                ProdText.enabled = true;
                DebugText.enabled = false;
            }
            else if (DebugText2.enabled)
            {
                if (DTPage <= 0)
                {
                    DebugText.enabled = true;
                    DebugText2.enabled = false;
                }
                else DTPage--;
            }
            else if (ProdText.enabled)
            {
                DebugText2.enabled = true;
                DTPage = 99;
                ProdText.enabled = false;
            }
            else DebugText.enabled = true;
        }
        if (Input.GetKeyDown((KeyCode)161))  // 前方切り替え
        {
            if (DebugText.enabled)
            {
                DebugText.enabled = false;
                DebugText2.enabled = true;
                DTPage = 0;
            }
            else if (DebugText2.enabled)
            {
                if (DTPage >= 99)
                {
                    DebugText2.enabled = false;
                    ProdText.enabled = true;
                }
                else DTPage++;

            }
            else if (ProdText.enabled)
            {
                ProdText.enabled = false;
                DebugText.enabled = true;
            }
            else DebugText.enabled = true;
        }

        int i;
        for (i = 0; i <= 400; i++)
        {
            if (Input.GetKeyDown((KeyCode)i))
            {
                DTArray[0, 0] = "入力されたキーのキーコードだよ！ : " + i.ToString();
            }
        }

        if (Input.GetButtonDown("Fire2")) // ミックスキー(左クリック)
        //if (Input.GetButtonDown("return")) // ガス抜き（ミクスチャ）: エンターキー
        {
            Mix_keydown = 1;
        }
        else if (Input.GetButtonUp("Fire2"))
        {
            Mix_keydown = 0;
        }
#endif

#if Disabled_in_b59
        // ■ファイル入出力(b52)
        // ステートセーブとしてShift - F1-F10でデータセーブ
        // F1-F10でデータを読み込む
        bool isShift = Input.GetKey(KeyCode.LeftShift) || Input.GetKey(KeyCode.RightShift); ;       // シフト入力
