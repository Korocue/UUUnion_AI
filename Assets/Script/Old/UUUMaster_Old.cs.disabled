    void UpdateMood()
    {
        dbg(0, 20, "■ムード");

        uuuDateTime = DateTime.Now;
        DateTime udt = uuuDateTime;

        int hr = udt.Hour;
        int mn = udt.Minute;
        int sc = udt.Second;
        int ms = udt.Millisecond;

        String TestTimeStr = "";
        if (false)
        {
            TestTime += dTime * 5000.0f;
            int TT = (int)TestTime;
            TT %= 86400;
            ms = 0;

            hr = TT / 3600;
            mn = (TT % 3600) / 60;
            sc = (TT % 60);
            TestTimeStr = "(TestTime - " + TT.ToString("D") + ")";

            // hr = 14;     // 昼
            // hr = 2;      // 夜
        }

        int hr2;
        int mn2;
        int sc2;
        int ms2;

        // 14時がムード最小値（14を差し引く）
        // 分と秒はそのまま加算
        if (hr >= 14)
        {
            dbg(0, 21, "昼間の14時以降");
            hr2 = hr - 14;
            mn2 = mn;
            sc2 = sc;
            ms2 = ms;
        }
        // 2時がムード最大値
        // 分と秒は差し引く（2を差し引いて12から引く）
        else if (hr >= 2)
        {
            dbg(0, 21, "真夜中2時以降");
            if (hr >= 8) dbg(0, 21, "昼の14時前");
            hr2 = 12 - (hr - 2);
            mn2 = -mn;
            sc2 = -sc;
            ms2 = -ms;
        }
        // 2時前は10から足す
        // 分と秒はそのまま加算
        else
        {
            dbg(0, 21, "日付変わって2時前");
            hr2 = 10 + hr;
            mn2 = mn;
            sc2 = sc;
            ms2 = ms;
        }

        dbg(0, 22,
            "現在時刻 - " + hr.ToString("D2") + " : " + mn.ToString("D2") + " : " + sc.ToString("D2") + " : " + ms.ToString("D3")
             + TestTimeStr
            );

        dbg(0, 23,
            "hr2 : " + hr2.ToString("D1") + ", mn2 : " + mn2.ToString("D1") + ", sc2 : " + sc2.ToString("D1") + ", ms2 : " + ms2.ToString("D1")
            );

        int moodtime = sc2 + mn2 * 60 + hr2 * 3600;
        dbg(0, 24, "moodtime : " + moodtime.ToString("D1"));

        Mood = ((float)moodtime / 43200f);
        dbg(0, 25, "ムード : " + Mood.ToString("F4"));

        // ムードが高いと背景が黒くなる
        float r = OrgMoodColor.r * (1 - Mood);
        float g = OrgMoodColor.g * (1 - Mood);
        float b = OrgMoodColor.b * (1 - Mood);
        float a = OrgMoodColor.a;

        Camera.backgroundColor = new Color(r, g, b, a);
    }

#if Disabled_in_b59
    IEnumerator AutoMix() // オートミクスチャ用コルーチン
    {
        while (true)
        {
            if (automix == 1)
            {
                if (irk == 0)
                {
                    automix_time = manual_automix_time;
                }
                else
                {
                    automix_time = irk_automix_time;
                }
                if (mix_state == 0)
                {
                    Anm_Union.ResetTrigger("Insp_return");
                    Anm_Union.ResetTrigger("Insp_idle");
                    Anm_Union.SetTrigger("Inspiration");
                    mt.ui.UI_ResetTrigger("Insp_idle");
                    mt.ui.UI_SetTrigger("Inspiration");

                    if (mix_state == 0)
                    {
                        //GetComponents<AudioSource>()[0].Play();
                        int r = Random.Range(1, 5);
                        if (r == 1) Sound03_a1.Play();
                        if (r == 2) Sound03_a2.Play();
                        if (r == 3) Sound03_a3.Play();
                        if (r == 4) Sound03_a4.Play();

                        // r = Random.Range(1, 4);
                        //if (r == 1) Sound01.Play();
                        //if (r == 2) Sound01_a.Play();
                        //if (r == 3) Sound01_b.Play();
                        mix_state = 1;
                        Mixture.DoMix();
                        ms_LastInsp = IngameTime;
                        //float ms_LastFrameTime = frameTime;
                        yield return new WaitForSeconds(automix_time * 0.5f);
                        // 差し込み0.5秒
                        // トレース用処理
                        while (IngameTime - ms_LastInsp < automix_time * 0.5f)
                        {
                            yield return new WaitForSeconds(0.01f);
                        }
                    }
                    //Anm_Union.SetIntege
                }
                else
                {
                    Anm_Union.ResetTrigger("Inspiration");
                    Anm_Union.SetTrigger("Insp_return");
                    if (mix_state == 1)
                    {
                        //AudioSource[] audios = GetComponents<AudioSource>();
                        int r = Random.Range(1, 4);
                        if (r == 1) Sound02.Play();
                        if (r == 2) Sound02_a.Play();
                        if (r == 3) Sound02_b.Play();
                        mix_state = 0;
                        Mixture.DoMix();
                        ms_LastInsp = IngameTime;
                        //float ms_LastFrameTime = IngameTime;
                        yield return new WaitForSeconds(automix_time * 0.2f);
                        // 抜き0.2秒
                        // トレース用処理
                        while (IngameTime - ms_LastInsp < automix_time * 0.2f)
                        {
                            yield return new WaitForSeconds(0.01f);
                        }
                    }
                }
            }
            else
            {
                Anm_Union.SetTrigger("Insp_return");
                yield return new WaitForSeconds(0.01f);
                Anm_Union.SetTrigger("Insp_idle");
                mt.ui.UI_SetTrigger("Insp_idle");
            }
        }
    }
#endif

