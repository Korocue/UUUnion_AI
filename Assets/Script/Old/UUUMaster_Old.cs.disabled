    public void SetMixVolume(float f)
    {
        Sound01.volume = DefVolume_Sound01 * f;
        Sound01_a.volume = DefVolume_Sound01_a * f;
        Sound01_b.volume = DefVolume_Sound01_b * f;
        Sound02.volume = DefVolume_Sound02 * f;
        Sound02_a.volume = DefVolume_Sound02_a * f;
        Sound02_b.volume = DefVolume_Sound02_b * f;

        Sound03_a1.volume = DefVolume_Sound03 * f;
        Sound03_a2.volume = DefVolume_Sound03 * f;
        Sound03_a3.volume = DefVolume_Sound03 * f;
        Sound03_a4.volume = DefVolume_Sound03 * f;
    }

