        // 右クリックでそれをガマンする
        // Gaman値の役割の変化に伴い
        // このセクションは削除予定
        if (false) // Union.TestCode == "Manjutane")
        {
            // 0.01 = 色っぽい空気
            Insp += 0.01 *
