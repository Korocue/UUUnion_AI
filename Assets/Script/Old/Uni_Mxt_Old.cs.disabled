    // 限界値に対するインスピ率をちょっと加工して返します
    // 限界値寸前でおよそ２倍になります
    // （がまん用）
    public double Mix_Rate()
    {
        return 5 * Mathf.Pow((float)(Insp / Insp_Limit), 2);
    }

    // インスピ値に対するすっきり値の割合を 0 - 1 の範囲で返す
    public float Sukkiri_Rate()
    {
        // すっきり値はb56からマイナスインスピ値に変更
        if (mInspMinus == "absorb")
        {
            // がまん限界の100%でマックスすっきり
            // float r = (float)(InspMinus / Gaman_Limit_p) * 1.0f;
            // がまん限界の50%でマックスすっきり
            float r = (float)(InspMinus / Gaman_Limit_p) * 2.0f;
            r = Mathf.Clamp(r, 0, 1);
            return r;
        }
        if (mInspMinus == "minus")
        {
            if (Sukkiri > Iroduki_Limit) return 1;
            if (Sukkiri < 0) return 0;
            return (float)(Sukkiri / Iroduki_Limit);
        }
        return 0;
    }

    // すっきり無効化率
    // インスピ値に対するすっきり値の割合を利用して
    // 引数で補正した値を返す
    // この補正値で少しでもすっきり値があると、0に近い値を返す
    public float Sukkiri_Invalid_Rate(float f)
    {
        if (Iroduki_Limit < 0) return 0;
        if (Sukkiri > Iroduki_Limit) return 0;
        if (Sukkiri < 0) return 1;

        float res = Mathf.Pow(1 - (float)(Sukkiri / Iroduki_Limit), f);
        if (res > 1)
        {
            res = 1;
        }
        if (res < 0)
        {
            res = 0;
        }
        return res;
    }

    // すっきりに無効化された値をさらに
    // こみあげ値により無効化して1に近い値に戻す
    public float Sukkiri_Invalid_Rate_B(float f, float f2)
    {
        if (Iroduki_Limit < 0) return 1;
        if (Haki_Komi > Iroduki_Limit) return 1;

        float invrate = Sukkiri_Invalid_Rate(f);                                    // すっきり値により無効化された部分を
        float invinvrate = Mathf.Pow(1 - (float)(Haki_Komi / Iroduki_Limit), f2);   // こみあげ値によりさらに無効化して1に近づける

        if (Haki_Komi < 0)
        {
            invinvrate = 0;
        }

        float res =
            1 -
            (float)(
                (1 - invrate)   // すっきり値により無効化された部分を
                * invinvrate    // こみあげ値によりさらに無効化して1に近づける
            );

        if (res > 1)
        {
            res = 1;
        }
        if (res < 0)
        {
            res = 0;
        }
        return res;
    }

    public float Sukkiri_Invalid_Rate_C(float f, float f2)
    {
        if (Iroduki_Limit < 0) return 1;
        if (Haki_Komi > Iroduki_Limit) return 1;

        float invrate = Sukkiri_Invalid_Rate(f);                                    // すっきり値により無効化された部分を
        float invinvrate = Mathf.Pow(1 - (float)(Komiage / Iroduki_Limit), f2);   // こみあげ値によりさらに無効化して1に近づける

        if (Haki_Komi < 0)
        {
            invinvrate = 0;
        }

        float res =
            1 -
            (float)(
                (1 - invrate)   // すっきり値により無効化された部分を
                * invinvrate    // こみあげ値によりさらに無効化して1に近づける
            );

        if (res > 1)
        {
            res = 1;
        }
        if (res < 0)
        {
            res = 0;
        }
        return res;
    }

    // チャンネル同士で移動する値を返すメソッド
    public double Absorb(double _inspsrc, double _inspdst, double dstmax, float rate, float dstpow)
    {
        // チャンネルに余裕があったら余計に詰め込んでしまう
        // これは円の面積みたいだよね、半径の2乗
        // そういうイメージの計算式
        // 逆も然りかな、多すぎると吐き出したくなる（パターン１）
        // これは単純にn乗して吐き出す
        // 吐き出す量をグラフにすると、下に近づいたグラフ
        //
        // 逆に少しでもあると吐き出すというイメージだと（パターン２）
        // （1/n）乗して吐き出す
        // 上（1）に近づいたグラフになる
        //
        // それも今のたまらん方式だと簡単に限界突破してしまうので
        // 肝心の方式がまったく意味を成していない
        //
        // とりあえず式がややこしいのでそういうメモ書き
        // 
        // そう考えるとAbsorbの方式もそういうカスタマイズ性を考えた方がいいのかも
        //
        // dstpow(n) : nが大きいと、少しでも余裕があれば大きく吐き出す
        // dstpow(1/n) : nが大きいと、十分に余裕が無ければ吐き出さない
        double dstlack = EasyMath.PowCurve(_inspdst, dstpow, dstmax);
        double _loss = _inspsrc * rate * dTime;
        double _cutoff = _inspsrc * dstlack * rate * dTime;
        double _loss2 = _loss - _cutoff;
        if (_loss2 > _inspsrc && _inspsrc >= 0)
        {
            _loss2 = _inspsrc;
        }
        return _loss2;
    }

    // インスピから色づきへの吸収量から
    // カットオフした後の値を返し、参照された引数にカットオフされた値を格納する
    public double Absorb_Cutoff(double _inspsrc, double _inspdst, double dstmax, float rate, float dstpow, ref double _cutoff)
    {
        double dstlack = EasyMath.PowCurve(_inspdst, dstpow, dstmax);
        double _loss = _inspsrc * rate * dTime;
        _cutoff = _inspsrc * dstlack * rate * dTime;
        double _loss2 = _loss - _cutoff;
        if (_loss2 > _inspsrc && _inspsrc >= 0)
        {
            _loss2 = _inspsrc;
        }
        return _loss2;
    }

    public void DownInsp(double _DownInsp)
    {
        double _DownInsp2 = _DownInsp;
        // 低ステージのインスピから消費する
        if (false)
        {
            if (Insp1p() > 0)
            {
                // インスピ量がインスピ1より多い場合は
                // インスピ1を全消費して
                // 高レベルインスピを消費出来るように残す
                // そうでない場合はインスピ消費が終わる（_DownInsp2が0になる）
                if (_DownInsp2 > Insp1p())
                {
                    // 純インスピ1値よりDownInspが多い場合
                    // Insp値から純粋Insp1pからそのまま無くす
                    // 残ったDownInspをInsp2値から減らす
                    _DownInsp2 -= Insp1p();
                    Insp -= Insp1p();
                }
                else
                {
                    Insp -= _DownInsp2;
                    _DownInsp2 = 0;
                }
            }
            if (Insp2p() > 0)
            {
                if (_DownInsp2 > Insp2p())
                {
                    // 純インスピ2値よりDownInspが多い場合
                    // Insp値から純粋Insp2pからそのまま無くす
                    // 残ったDownInspをInsp3値から減らす予定
                    _DownInsp2 -= Insp2p();
                    Insp -= Insp2p();
                }
                else
                {
                    Insp2 -= _DownInsp2;
                    Insp -= _DownInsp2;
                }
            }
        }

        // 高ステージのインスピから消費する
        if (true)
        {
            DownInsp3(_DownInsp);
        }
        if (Insp < 0)
        {
            InspMinus += -Insp;
            Insp = 0;
        }
    }

    public void DownInsp3(double _DownInsp)
    {
        if (Insp3 > 0)
        {
            if (_DownInsp > Insp3)
            {
                Insp3 = 0;
            }
            else
            {
                Insp3 -= _DownInsp;
            }
        }
        else
        {
            Insp3 = 0;
        }
        DownInsp2(_DownInsp);
    }

    public void DownInsp2(double _DownInsp)
    {
        if (Insp2 > 0)
        {
            if (_DownInsp > Insp2)
            {
                Insp2 = 0;
            }
            else
            {
                Insp2 -= _DownInsp;
            }
        }
        else
        {
            Insp2 = 0;
        }
        Insp -= _DownInsp;
    }

    public double InspVolume()
    {
        // Insp1の質量にInsp2の質量を足す
        return (Insp1p() * GamanVolume()
            + Insp2Volume());
    }

    public double Insp2Volume()
    {
        return (Insp2p() * 0.1f * GamanVolume()
            + Insp3Volume());
    }
    public double Insp3Volume()
    {
        return (Insp3p() * 0.01f * GamanVolume()
            // + Insp4Volume();
            + 0);
    }

    // insp2値以降を除いた純粋なInsp1値
    // pureのpを取ってる
    public double Insp1p()
    {
        return Insp - Insp2;
    }

    // Insp1pの率
    public double Insp1p_Rate()
    {
        return Insp1p() / Gaman;
    }

    // 純粋なInsp2値
    public double Insp2p()
    {
        //return Insp2;
        return Insp2 - Insp3;
    }

    public double Insp2p_Rate()
    {
        return Insp2p() / Gaman;
    }

    // 純粋なInsp2値
    public double Insp3p()
    {
        return Insp3;
        // return Insp3 - Insp4;
    }

    public double Insp3p_Rate()
    {
        return Insp3p() / Gaman;
    }

    // インスピ減衰量を返す
    // noadjust（補正なし）
    public double Insp_Loss(double _insp, bool noadjust = false)
    {
        // 色づきの不足によってインスピ低下
        // 倍率は10?
        double _loss = _insp
        * (1 - EasyMath.PowCurve(Iroduki, 5f, Iroduki_Limit))   // 色づきに少しでも余裕があれば大きく吐き出す
                                                                // * 2
                * 1
                // * 0.5
                * dTime;
        // 爆発が近いと補正が強くなる
        if (!noadjust)
        {
            _loss +=
                _insp
                * (1 - EasyMath.PowCurve(Iroduki, 2f, Iroduki_Limit))
                * EasyMath.PowCurve(Insp_Rate(_insp), 0.5f, 1)
                // * 0.5f
                * 0.2f
                // * 0.1f
                * dTime;
        }
        // ためこみ値が溜まっていればその分色づきに吸収される
        // ためこみ値がないとインスピが抑えられないことになる
        //Insp_Loss *= ((Tamekomi - Iroduki) / Tamekomi_Limit);
        if (_loss > _insp) _loss = _insp;
        return _loss;
    }

    // 現在のインスピ率を返す
    // 1に近づくほどバクハツが近い
    public float Insp_Rate(double _insp)
    {
        return (float)(_insp / Insp_Limit);
    }

    // がまん限界に対する現在のインスピ率を返す
    // 仮実装
    public float Insp_Rate_B(double _insp)
    {
        return (float)(_insp / Gaman_Limit);
    }

