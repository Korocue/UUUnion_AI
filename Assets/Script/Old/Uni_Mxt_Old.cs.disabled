        // インスピ減衰処理

        // インスピ減衰
        if (uuu.TestCode == "Kurimanju")
        {
            // 色づきの不足によってインスピ低下
            // 倍率は10?
            /*Insp_Loss = Insp
                * (1 - EasyMath.PowCurve(Iroduki, 5f, Iroduki_Limit))
