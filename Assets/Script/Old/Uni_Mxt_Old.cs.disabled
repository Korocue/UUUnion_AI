        // UpdateMix()に対して
        // こちらはこすり下げとこすり上げ時の命令を処理する

        //if (Union.mix_state == 1) Mix = Pre_Mix;

        if (un.mix_state == 1)
        {
            // ミクスチャだけで無条件にミクスチャ値増加
            //Mix += MixStrength;
        }

        // こすり上げ時に50%程度のボーナスが入る
        // プリミクスチャの不足分だけ、つまり十分こすり下げがされてる状態でボーナスが入る
        // UpdateMixで行うべき処理をここで行ってしまっているので
        // そのうちまとめる予定
        // Pre_Mix_Bonusはミクスチャ強度を適用しない0-1の値

        if (false)
        //if (Union.mix_state == 0)
        {
            dIrk += (1 - Pre_Mix) * 0.5 * Fl_Mix
                * 0.01f;

            Fl_Mix -= (1 - Pre_Mix) * 0.5 * Fl_Mix
                * 0.01f;

            Mix += MixStrength * 0.5 * (1 - Pre_Mix);
            dIrk -= MixStrength * 0.5 * (1 - Pre_Mix); // 色気づき消費
            dPre_Mix_Bonus += (1 - Pre_Mix) * 0.5;
            //Mix += (MixStrength - Pre_Mix) * 0.5;
            //dPre_Mix_Bonus += (MixStrength - Pre_Mix) * 0.5;
        }
    }

    public double GetMix()
    {
        // インスピレーション蓄積量は決して1を越えない
        // this.Mix_b = EasyMath.ConvTo(this.Mix_a, 1.0f, 1.0f);

        this.Mix_b = Mix_a;
        return Mix = Mix_b * (Sukkiri_Invalid_Rate_B(1, 1));
    }

    // 子ポップ処理・廃棄
    float UpdateIrodukiChildPop()
    {
        // 小ポップの合算を渡し、後に全体のポップの大きさにさらに合算する
        float t_val = 0;

        int n = Iroduki_nChildPop;
        while (n-- > 0)
        {
            //using (FileStream fs = new FileStream("hoge.txt", FileMode.Open, FileAccess.Read, FileShare.None))

            // using st = Iroduki_ChildPop[n];
            //_Iroduki_ChildPop st = Iroduki_ChildPop[n];
            Iroduki_ChildPop[n].posx += (Iroduki_ChildPop[n].posgx - Iroduki_ChildPop[n].posx) * 2 * dTime;
            Iroduki_ChildPop[n].posy += (Iroduki_ChildPop[n].posgy - Iroduki_ChildPop[n].posy) * 2 * dTime;
            //Iroduki_ChildPop[n].
            Vector3 pos = Iroduki_ChildPop[n].obj.transform.localPosition;
            pos.x = ui.ip.ConvertScale(Iroduki_ChildPop[n].posx);
            pos.y = ui.ip.ConvertScale(Iroduki_ChildPop[n].posy);
            Iroduki_ChildPop[n].obj.transform.localPosition = pos;
            double time = Iroduki_ChildPop[n].time;
            float val = 0.1f * ((float)time / 5.0f);
            if (time > 4.9f)
            {
                val *= (float)(5.0f - time) * 10.0f;
            }

            t_val += val;
            float ps = ui.ip.ConvertScale(val);
            // Vector3 scale = new();
            //scale.x = 1.0f * ((float)time / 5.0f);
            //scale.y = 1.0f * ((float)time / 5.0f);
            Iroduki_ChildPop[n].obj.transform.localScale = new Vector3(ps, ps, ps);
            Iroduki_ChildPop[n].time -= dTime;
            if (Iroduki_ChildPop[n].time < 0)
            {
                Destroy(Iroduki_ChildPop[n].obj);
                Iroduki_ChildPop.Remove(Iroduki_ChildPop[n]);
                Iroduki_nChildPop--;
            }
        }
        return t_val;
    }

