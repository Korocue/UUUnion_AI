    public float Iroduki_Rate()
    {
        return (float)(Iroduki / Iroduki_Limit);
    }

    // 色づき吸収
    void IrodukiAbsorb(double value)
    {
        // 色づきがインスピを1%ずつ吸収
        // ミクスチャをし続けていれば最終的にはバクハツする
        double IrodukiAbsorbInsp =
            //value * (1.0f / Iroduki_Capacity);                           // 色づきの許容量に応じて吸収割合を変化させる（100倍なら1%）
            value;                                                         // b50からインスピ値が全部のチャンネルにおいて等価になった
                                                                           //* ((Tamekomi - Iroduki) / Tamekomi_Limit);
                                                                           // * (Tamekomi / Tamekomi_Limit);
                                                                           // ためこみ値が溜まっている分だけ色づくが
                                                                           // ため込み値が足りない分は色づきにも吸収されずロスになる
        Iroduki += IrodukiAbsorbInsp;

        // 子ポップを湧かせる
        // 子ポップを湧かせるエネルギーを蓄積させる
        Iroduki_Absorbing += IrodukiAbsorbInsp;
        // 一定時間経つか、0.1溜まったら新ポップを生成する
        while (false)
        {
            // 湧かせる
            _Iroduki_ChildPop NewChildPop = new();
            NewChildPop.obj = Instantiate(ICPop_0_1, new Vector3(0, 0, 0), Quaternion.identity, ui.ip.InspPopMaster.transform);
            NewChildPop.time = 5.0f;
            NewChildPop.posx = 0;
            NewChildPop.posy = 0;
            Random.InitState((int)System.DateTime.Now.Ticks);
            NewChildPop.posgx = Random.value * 3.0f - 1.5f;
            NewChildPop.posgy = Random.value * 3.0f - 1.5f;
            NewChildPop.obj.SetActive(true);
            //NewChildPop.obj.

            Iroduki_ChildPop.Add(NewChildPop);
            Iroduki_nChildPop++;

            /*GameObject NewProdPop;
            NewProdPop = Instantiate(ProdPopOrg, new Vector3(0, 0, 0), Quaternion.identity);
            NewProdPop.GetComponent<ProdPop>().Product = Producable();
            NewProdPop.GetComponent<ProdPop>().Sukkiri = a;
            NewProdPop.GetComponent<ProdPop>().Uni_Mxt = this;
            NewProdPop.GetComponent<ProdPop>().times = 1;               // 応急処置：timesが０だと表示時間なしと見なされて消去される？
            ProdPops.Add(NewProdPop);

            NewProduct = Instantiate(Prod_Syrup_Org, new Vector3(0, 0, 0), Quaternion.identity);
            NewProduct.GetComponent<Product>().Grade = (int)(b / 1);        // シロップの生産量は1の倍数
            }
            NewProduct.SetActive(false);
            NewProduct.GetComponent<Product>().Union = Union;
            NewProduct.GetComponent<Product>().Born_Pos = Union.transform.Find("Anim/Shadow_Pos").gameObject.transform.position.y;
            ProductFlavors.Add(NewProduct);
            Birth(b);*/

            //Iroduki_ChildPop.Add = new GameObject;

            Iroduki_Absorbing -= 0.1f;
        }

        StatIrodukiAbsorbInsp += IrodukiAbsorbInsp;      // インスピ吸収量
    }

    // 色づき更新（Kurimanju旧バージョン）
    void UpdateIroduki_Kurimanju()
    {
        double flInc = 0;               // 増加量
        double flLim = 0;               // 増加上限
        double flLimFinal = 0;          // 色づき上限を適用した最終的な値

        // フレーバー(色っぽい雰囲気) = 20
        double flIncDefault = 0.01f
            * KomiageCr()
            * (Sukkiri_Invalid_Rate_B(1, 1));
        flLim += 20;
        if (flLim > Iroduki_Limit) flLimFinal = Iroduki_Limit; else flLimFinal = flLim;
        if (flLimFinal > Iroduki)
        {
            Iroduki += flIncDefault * (1 - Iroduki / flLimFinal);
        }
        // フレーバー(ミクスチャ) = 50
        double flIncMix = EasyMath.ConvTo(Mix, 0.05f, 2.0f)
            * KomiageCr()                                        // 少しでもこみ上げたら色づかない
            * (Sukkiri_Invalid_Rate_B(1, 1));                                 // すっきりしたら色づかない
        flLim += 50;
        if (flLim > Iroduki_Limit) flLimFinal = Iroduki_Limit; else flLimFinal = flLim;
        if (flLimFinal > Iroduki)
        {
            Iroduki += flIncMix * (1 - Iroduki / flLimFinal);
        }
        // フレーバー（ミクスチャ完成／こみあげ）= 100(初期)
        double flIncCompletion = Komiage * 0.001f
            * (Sukkiri_Invalid_Rate_B(1, 1));                           // すっきりしたら色づかない
                                                                        // こみあげてもすっきりするまで色づき続ける
                                                                        //flLim += Komiage;
        flLim += 100;
        if (flLim > Iroduki_Limit) flLimFinal = Iroduki_Limit; else flLimFinal = flLim;
        if (flLimFinal > Iroduki)
        {
            Iroduki += flIncCompletion * (1 - Iroduki / flLimFinal);
        }
        // フレーバー（生産物）
        double flIncProd = 0;
        double flLimProd = 0;
        int ElmKCount = 0;
        int ElmKGradeSum = 0;
        int MotiCount = 0;
        int MotiGradeSum = 0;
        int WhipCount = 0;
        int WhipGradeSum = 0;
        int SyrupCount = 0;
        int SyrupGradeSum = 0;
        for (int i = 0; i < 50; i++)
        {
            // エレメント
            if (i > 30)
            {
                ElmKCount += un.ProductItems[i];
                ElmKGradeSum += un.ProductItems[i] * (i - 30);             // グレード加算
            }
            if (i > 20)
            {
                MotiCount += un.ProductItems[i];
                MotiGradeSum += un.ProductItems[i] * (i - 20);             // グレード加算 - 29なら9
            }
            else if (i > 10)
            {
                WhipCount += un.ProductItems[i];
                WhipGradeSum += un.ProductItems[i] * (i - 10);             // グレード加算 - 19なら9
            }
            else
            {
                SyrupCount += un.ProductItems[i];
                SyrupGradeSum += un.ProductItems[i] * (i - 0);             // グレード加算 - 9なら9
            }
        }
        // 生産物の色づき量について
        // 位置づけ的にはクッキークリッカーの施設のようなものになっているが
        // 同作と比べて種類毎の生産量が格段に多いので
        // 効果量が小さく、その分頭打ちになる量も大き目に設定している
        // （対数関数の底がかなり小さくなっている／およそ１０分の１）
        /*if (ElmKCount > 0)
        {
            flIncProd += Mathf.Log(1 + ElmKCount * 0.01f, 1.01f) * ((float)ElmKGradeSum / (float)ElmKCount) * 1000 * 0.001f;     // モチ
            flLimProd += Mathf.Log(1 + ElmKCount * 0.01f, 1.01f) * ((float)ElmKGradeSum / (float)ElmKCount) * 1000;              // モチ
        }
        if (MotiCount > 0)
        {
            flIncProd += Mathf.Log(1 + MotiCount * 0.01f, 1.01f) * ((float)MotiGradeSum / (float)MotiCount) * 100 * 0.001f;     // モチ
            flLimProd += Mathf.Log(1 + MotiCount * 0.01f, 1.01f) * ((float)MotiGradeSum / (float)MotiCount) * 100;              // モチ
        }
        if (WhipCount > 0)
        {
            flIncProd += Mathf.Log(1 + WhipCount * 0.01f, 1.01f) * ((float)WhipGradeSum / (float)WhipCount) * 10 * 0.001f;      // ホイップ
            flLimProd += Mathf.Log(1 + WhipCount * 0.01f, 1.01f) * ((float)WhipGradeSum / (float)WhipCount) * 10;               // ホイップ
        }
        if (SyrupCount > 0)
        {
            flIncProd += Mathf.Log(1 + SyrupCount * 0.01f, 1.01f) * ((float)SyrupGradeSum / (float)SyrupCount) * 1f * 0.001f;      // シロップ
            flLimProd += Mathf.Log(1 + SyrupCount * 0.01f, 1.01f) * ((float)SyrupGradeSum / (float)SyrupCount) * 1f;               // シロップ
        }*/
        if (ElmKCount > 0)
        {
            flIncProd += Mathf.Log(1 + ElmKCount * 0.001f, 1.001f) * ((float)ElmKGradeSum / (float)ElmKCount) * 100 * 0.001f;     // モチ
            flLimProd += Mathf.Log(1 + ElmKCount * 0.001f, 1.001f) * ((float)ElmKGradeSum / (float)ElmKCount) * 100;              // モチ
        }
        if (MotiCount > 0)
        {
            flIncProd += Mathf.Log(1 + MotiCount * 0.001f, 1.001f) * ((float)MotiGradeSum / (float)MotiCount) * 10 * 0.001f;     // モチ
            flLimProd += Mathf.Log(1 + MotiCount * 0.001f, 1.001f) * ((float)MotiGradeSum / (float)MotiCount) * 10;              // モチ
        }
        if (WhipCount > 0)
        {
            flIncProd += Mathf.Log(1 + WhipCount * 0.001f, 1.001f) * ((float)WhipGradeSum / (float)WhipCount) * 1 * 0.001f;      // ホイップ
            flLimProd += Mathf.Log(1 + WhipCount * 0.001f, 1.001f) * ((float)WhipGradeSum / (float)WhipCount) * 1;               // ホイップ
        }
        if (SyrupCount > 0)
        {
            flIncProd += Mathf.Log(1 + SyrupCount * 0.001f, 1.001f) * ((float)SyrupGradeSum / (float)SyrupCount) * 0.1f * 0.001f;      // シロップ
            flLimProd += Mathf.Log(1 + SyrupCount * 0.001f, 1.001f) * ((float)SyrupGradeSum / (float)SyrupCount) * 0.1f;               // シロップ
        }
        flIncProd *=
            KomiageCr()                          // 少しでもこみ上げたら色づかない
            * (Sukkiri_Invalid_Rate_B(1, 1));       // すっきりしたら色づかない
        flLim += flLimProd;
        if (flLim > Iroduki_Limit) flLimFinal = Iroduki_Limit; else flLimFinal = flLim;
        if (flLimFinal > Iroduki)
        {
            if (uuu.TestCode == "Kurimanju")
            {
                Iroduki += flIncProd * (1 - Iroduki / flLimFinal);
            }
        }

        dbgflIncProd = flIncProd;
        dbgflLimProd = flLimProd;

        Iroduki_IncreaseLimit = flLim;

        if (uuu.TestCode == "Kurimanju")
        {
            Iroduki += Insp_Loss(Insp) * 0.01;
        }
        // ミクスチャをし続けていれば最終的にはバクハツする

        if (uuu.TestCode == "Manjutane")
        {
            //Iroduki += 1 + dTime;
            // 「警告」の秒間１秒増加
        }

        //StatIrodukiAbsorbInsp += Insp_Loss * 0.01;      // インスピ吸収量
    }

    // 色づき限界値
    // 現在暫定的にためこみ限界値を流用中
    void UpdateIrodukiLimit()
    {
        // 結果的にフレーバーが引き金になった生産物によって色づき限界が上がる
        //Iroduki_Limit_Base = Tamekomi_Limit_Base;
        Iroduki_Limit = Gaman_Limit;
        //Iroduki_Limit = Tamekomi_Limit;
    }

    // 色づき限界値（Kurimanjuの旧版）
    void UpdateIrodukiLimit_Kurimanju()
    {
        //Iroduki_Limit_Base = 50 + Mathf.Pow((float)Product / 100, 0.5f) * 100;          // 総生産量に基づいてインスピ許容値がインフレ

        // 総生産量に基づいてインスピ許容値がインフレ
        // だけど、インスピを吸収して強引に色づきを上げた場合、色づき限界は上がらない
        // 結果的にフレーバーが引き金になった生産物によって色づき限界が上がる
        Iroduki_Limit_Base = 1 + (float)(Product / 10);
        //Iroduki_Limit_Base = 10 + (float)((Product - StatIrodukiAbsorbInsp) / 10) * 2;    
        Iroduki_Limit = Iroduki_Limit_Base;
    }
    void UpdateGaman()
    {
        double Gaman_Left = Gaman_Limit - Gaman;        // 残りがまん量
        double Gaman_Left_Rate = (Gaman_Limit - Gaman) / Gaman_Limit;       // その割合
        double Gaman_Rate_a = (Gaman - Insp) / Gaman;   // インスピ値のがまん値に対する割合

        // がまん質量
        // 初期は10%、がまん値が上がる度に体積が増える
        // 
        //double Gaman_Volume = 0.1 * (0.1f / Gaman);                   // がまん質量はメソッド化
        double Insp1_Volume = Insp1p();                                 // インスピステージ１の質量（インスピ2値を取り除いたもの）
        double Insp2_Volume = Insp2p() / GamanVolume_Insp2();           // インスピステージ２の質量（インスピ3値以降があれば取り除く）
        double Insp3_Volume = Insp3p() / GamanVolume_Insp3();           // インスピステージ３の質量（インスピ4値以降があれば取り除く）
        double Insp_Volume = Insp1_Volume
            + Insp2_Volume
            + Insp3_Volume
            ;               // インスピ質量（圧縮適用されたもの）


        double Insp_Left = Gaman - Insp;                                   // 残りインスピ量
        double Insp_Left_Rate = Insp_Left / Gaman;                       // その割合
        double IV_Left = Gaman - Insp_Volume;
        double IV_Left_Rate = IV_Left / Gaman;                          // 残りインスピ質量

        // 100%に達するための質量は0.1
        //double Insp_Left = 0.01f - Insp_Volume;                           // 残りインスピ量
        //double Insp_Left_Rate = Insp_Left / 0.1f;                       // その割合
        //double Insp_Left_Rate = (Gaman - Insp) / Gaman; // その割合

        // 初期の残りがまん量は90くらい（初期のインスピ許容値が10として）
        // 初期の残りインスピ量は10くらい
        // 割合で示すと我慢量が90%、インスピ量が100%
        // この割合が等しくなるように我慢量を増やす？

        // 残りがまん量の割合に対する、残りインスピ量の割合
        // （どれだけがまんする余地があるか）
        double a = Gaman_Left_Rate - Insp_Left_Rate;

        // インスピが切迫している場合、ちょっとずつがまんする
        // それが追い付かないと爆発する
        double UpGaman = Gaman_Limit * a * 0.01f * dTime;
        //Gaman += UpGaman;
        Gaman_p = Insp2;
        Gaman = 0.1f + Gaman_p;
        // 0除算を防ぐために下駄を履かせる
        // 純粋な値はGaman_p値

        if (true)
        //if (UpGaman > 0)
        {
            // インスピ3値に圧縮する
            // a3 - どれだけステージ3までガマンできるか
            double aa3 = (Gaman_Limit_p - 1.0f);             // ステージ3の総ガマン量
            double ab3 = 0;                          // そのうちの残りガマン量
            double a3 = 0;                           // 残りガマン量の割合
            if (aa3 > 0)
            {
                ab3 = aa3 - Insp3;                   // そのうちすでにガマンしてる分を差し引く
                a3 = ab3 / aa3;                   　 // 残りガマン量の割合
            }

            // a3が0以上ならガマン出来る
            if (ab3 > 0)
            {
                double UpInsp3_a = ab3 * Insp2p();
                // 残りガマン量と残りインスピ量を掛け合わせる
                double UpInsp3 = UpInsp3_a * Insp2p_Rate() * 0.1f;
                // そこにさらにインスピ質量で増加量を補正する
                Insp3 += UpInsp3 * dTime;
                //UpGaman -= UpGaman3;
                if (Insp3 > Insp2) Insp3 = Insp2;
            }

            // インスピ2値に圧縮する
            double aa2 = (Gaman_Limit_p);             // ステージ2の総ガマン量
            double ab2 = 0;                          // そのうちの残りガマン量
            double a2 = 0;                           // 残りガマン量の割合
            if (aa2 > 0)
            {
                ab2 = aa2 - Insp2;                   // そのうちすでにガマンしてる分を差し引く
                a2 = ab2 / aa2;                   　 // 残りガマン量の割合
            }

            // a2が0以上ならガマン出来る
            if (ab2 > 0)
            {
                double UpInsp2_a = ab2 * Insp1p();
                // double UpInsp2_a = ab2 * Insp1p_Rate();
                // Rateに設定するとがまん限界の上昇に従ってレートが低下して
                // がまんが上昇しなくなってしまう
                double UpInsp2 = UpInsp2_a * Insp1p_Rate() * 1.0f;
                Insp2 += UpInsp2 * dTime;
                //Insp2 += UpGaman * Insp1p_Rate();
                if (Insp2 > Insp) Insp2 = Insp;
            }
        }

        // とりあえず我慢上限の1割を下回らないようにする
        //if (Gaman < Gaman_Limit * 0.1f)
        //{
        //    Gaman = Gaman_Limit * 0.1f;
        //}

        if (Gaman < 0.1f)
        {
            Gaman = 0.1f;
        }

        if (Gaman < Haki_Komi_b)
        {
            Gaman = Haki_Komi_b;
            // ちょっと吐き切るまで我慢してて
            // まさかのはきこみb値が使えそうと判明
        }

        // 最後にふっくら値で補正をかける
        // Gaman_p += Fkr;
        // Gaman += Fkr;

        // 我慢の限界量を超えないようにする
        if (Gaman > Gaman_Limit)
        {
            Gaman = Gaman_Limit;
        }
    }

    void UpdateGamanLimit()
    {
        //Iroduki_Limit_Base = 50 + Mathf.Pow((float)Product / 100, 0.5f) * 100;          // 総生産量に基づいてインスピ許容値がインフレ

        // がまん値（インスピ許容値の流用）
        // 総生産量に基づいてインスピ許容値がインフレ
        GamanRaw_Limit_p = 1 + Mathf.Pow((float)Product + 1, 0.5f) - 1;
        // 100生産して10倍になるくらいの量

        GamanRaw_Limit = GamanRaw_Limit_p + 0.1f;
        // 0除算を防ぐための下駄履き

        // ふっくら値を加算する
        Gaman_Limit_p = GamanRaw_Limit_p + Fkr;
        Gaman_Limit = GamanRaw_Limit + Fkr;

        // Gaman_Limit = 1 + (float)(Product / 10);
        // Iroduki_Limit_Base = 10 + (float)((Product - StatIrodukiAbsorbInsp) / 10) * 2;    
        // Iroduki_Limit = Iroduki_Limit_Base;
    }

    // がまん率
    // "reverse"を引数にすると逆レートを返す
    public float Gaman_Rate(string reverse = "")
    {
        float r = (float)(Gaman_p / Gaman_Limit_p);
        if (r < 0) r = 0;
        if (r > 1) r = 1;
        if (reverse == "reverse") return 1 - r;
        return r;
    }

    // がまん値による圧縮率を返す
    // 0.1で1、1で10、10で100……
    public double GamanVolume()
    {
        return Gaman * 10f;
    }

    // ステージ２のインスピ値は圧縮率最大10倍
    public double GamanVolume_Insp2()
    {
        /*double _GamanVolume = GamanVolume();
        if (_GamanVolume > 10)
        {
            return 10.0f;
        }
        
        return _GamanVolume;*/
        return 10.0f;
    }

    public double GamanVolume_Insp3()
    {
        /*double _GamanVolume = GamanVolume();
        if (_GamanVolume > 100)
        {
            return 100;
        }

        return _GamanVolume;*/
        return 100.0f;
    }

    // 色づき上限で割って
    // 指定されたスケールをかけて調整する
    // 後半に色づきが増えても大きくなりすぎないようにする調整
