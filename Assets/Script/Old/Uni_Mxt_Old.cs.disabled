                // Gaman -= (1 - EasyMath.Gaman(InspOver, Gaman)) * 0.01 * dTime;       // 生産量を抑えた分だけガマンを消費する
                // Gaman_Exp += (1 - EasyMath.Gaman(InspOver, Gaman)) * 0.01 * dTime;   // 生産を抑えた分だけガマン強さが上昇する
            }
            // 考える（最初のフレーバー？）
            // 0.015の速度でインスピが溜まり、0.02の速度で生産する

            //Union.FlavorThink()
            /*if (Insp > 0.02 * 100)
            {
                double InspOver = Insp - 0.02 * 100;                    // 「考える」のためのインスピ超過量
                double InspOverRatio = EasyMath.Yeast(InspOver / (0.02 * 100));

                double GamanAmount = ; // ガマン量
                double FlavorGaman = EasyMath.Gaman(InspOver, Gaman);
                Union.FlavorThink.Level = InspOverRatio;

                // 「考える」と0.015の速度でインスピレーションが溜まる
                // ただし超過した分のみ・考えるのをガマンした分は抑えられる
                Insp += 0.015 *
