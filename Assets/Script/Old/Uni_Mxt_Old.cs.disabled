        float max_scale = InspPop_MaxScale;
        float _sc = (float)(Mathf.Sqrt((float)(Mathf.Abs((float)sc)) * (float)(max_scale)));
        // float _sc = (float)(Mathf.Sqrt((float)(Mathf.Abs((float)sc)) * (float)(max_scale / Gaman_Limit)));
        // 
        if (sc < 0)
        {
            return -_sc;
        }
        return _sc;
    }*/

    void UpdateDokidoki()
    {
        Dokidoki = Insp - Dokidoki_Cap;

        // ドキドキは秒間50%ずつ慣れていく
        Dokidoki_Cap += Dokidoki * 0.5 * dTime;

        // ドキドキ耐性は10%ずつ減退していく
        // Dokidoki_Cap -= Dokidoki_Cap * 0.1 * dTime;
    }

    // ためこみ
    void UpdateTamekomi()
    {
        // 秒間0.5%ずつ増加
        Tamekomi += (Tamekomi_Limit - Tamekomi) * 0.005 * dTime;
    }

    // ためこみ限界値更新
    // 現在色づき限界値のものを流用中
    void UpdateTamekomiLimit()
    {
        //Iroduki_Limit_Base = 50 + Mathf.Pow((float)Product / 100, 0.5f) * 100;          // 総生産量に基づいてインスピ許容値がインフレ

        // 総生産量に基づいてインスピ許容値がインフレ
        // だけど、インスピを吸収して強引に色づきを上げた場合、色づき限界は上がらない
        // 結果的にフレーバーが引き金になった生産物によって色づき限界が上がる
        //Tamekomi_Limit = Tamekomi_Limit_Base + (float)((Product - StatIrodukiAbsorbInsp) / 10) * 2;

        // b41で使用していた最新の式（現在コメントアウト中）
        //Tamekomi_Limit = Tamekomi_Limit_Base + (float)(Product - (StatIrodukiAbsorbInsp / 10.0f)) * 1;
    }

    // ■こみあげ上昇補正値
    // 現在こみあげているかどうかの指数を返す
    // (CoRrection value)
    // 実質のバクハツ判定で
    // 「バクハツ中にすっきり値を減らさない」などの
    // バクハツ中に何らかの動作を止めたい時に使う変数
    float KomiageCr()
    {
        float KomiageCr = Mathf.Pow(Mathf.Abs((float)(1 - Komiage / (Komiage_Limit + 0.001f))), 10.0f); // 少しでもこみ上げたらすっきりが治らない
        if (KomiageCr > 1) KomiageCr = 1;
        return KomiageCr;
    }

    // 完成
    void Kansei()
    {
        //dProduct += (Komiage - dProduct) * 0.7;    // うにおん「こみあげた分の7割をこれから生産するよ」
        //dProduct += Funbari;    // うにおん「ふんばった分生産するうにょ」

        GameObject NewProduct;

        //double Productable = Funbari - dProduct;                        // この値は何度も更新する必要がある
        //if (Productable > Komiage_Limit) Productable = Komiage_Limit;

        // 生産可能でなければどっくん値をこみ上げ値に固定する
        // そうでないと、音がうるさいことになってしまう
        //if (Producable() >= 1.0f)

        if (Producable() >= 1.0f)
        {
            Kansei_Hakidasi(Umareru);
        }
        else
        {
            Kansei_Hakidasi(Umareru);
            //Iroduki -= Dokkun;

            // 色づきロス
            double a = Umareru * (1 - ((Insp) / (Gaman_Limit + 0.01f))) * 10.0f;
            // double a = Dokkun * ((Iroduki_Limit + 0.01f) / (Komiage + 0.01f));
            // double a = Dokkun * ((Iroduki_Limit_Base + 0.01f) / (Komiage + 0.01f));
            dSukkiri += a;
            // どっくん値が高いのにふんばりが追い付いていない場合に挙動がおかしくなるので
            // ふんばり値を無理やり1に設定して残り汁を搾り取ってあげる
            /*if (Dokkun >= 1)
            {
                //Funbari = 1 + dProduct + 0.5f;     // ふんばり値を強制的に１にして最低でもシロップを１つ生産させる（念のため0.5余裕を持たせる）
                Dokkun = 0;
            }
            else
            {
                Dokkun = Komiage;
            }*/
            
            if (Producable() > 0.005f)
            {
                GameObject NewProdPop;
                NewProdPop = Instantiate(uuu.ProdPopOrg, new Vector3(0, 0, 0), Quaternion.identity);
                NewProdPop.GetComponent<ProdPop>().Product = Producable();
                NewProdPop.GetComponent<ProdPop>().Sukkiri = a;
                NewProdPop.GetComponent<ProdPop>().uuu = this.uuu;
                NewProdPop.GetComponent<ProdPop>().mt = this;
                NewProdPop.GetComponent<ProdPop>().times = 1;               // 応急処置：timesが０だと表示時間なしと見なされて消去される？
                un.ProdPops = new List<GameObject>();                       // 生産ポップ配列初期化ProdPops.Add(NewProdPop);
            }
            Birth(Umareru);
            un.ProductHeart += Umareru;
        }

        if (Producable() >= 1.0f)
        {
            // 基本的にインスピ限界に応じた生産量ですっきりするが
            // こみ上げが少ないと、同じこみあげでもすっきりしてしまう
            // こみ上げが多い方（色づきが多い方）が有利
            // 残り汁ですっきりしすぎないように初期の大きなこみあげ値で計算
            double a = Umareru * (Iroduki_Limit_Base / Komiage);
            dSukkiri += a;
            //Dokkun = 0;
            //Debug.Log(Funbari.ToString("F3") + " 生産して " + a.ToString("F3") + " すっきりしました。");
                                                                     // (1.0f * (Iroduki - Funbari) / Insp_Limit));
                                                                     // (1.0f + (2.0f - (Iroduki - Funbari) / Insp_Limit));   // 減った後の色づき値で計算
            if (dSukkiri > Iroduki_Limit) dSukkiri = Iroduki_Limit;

            GameObject NewProdPop;

            NewProdPop = Instantiate(uuu.ProdPopOrg, new Vector3(0, 0, 0), Quaternion.identity);
            NewProdPop.GetComponent<ProdPop>().Product = Mathf.Floor((float)Producable());
            NewProdPop.GetComponent<ProdPop>().Sukkiri = a;
            NewProdPop.GetComponent<ProdPop>().uuu = this.uuu;
            NewProdPop.GetComponent<ProdPop>().mt = this;
            NewProdPop.GetComponent<ProdPop>().times = 1;               // 応急処置：timesが０だと表示時間なしと見なされて消去される？
            un.ProdPops.Add(NewProdPop);
        } else
        {
            // dSukkiri += (1 - EasyMath.PowCurve(Iroduki, 5.0f, Iroduki_Limit)) * Iroduki_Limit * 0.001;
            // 色づきがなくなった分だけすっきりするが動作に違和感しかなかったのでコメントアウト
        }

        // 生産可能な生産物とグレードを上から順番に走査する
        for(double b = 9000.0f; Producable() >= 1.0f; /*なし*/ )
        {
            double a = Umareru / 2;
            if (a < 1) a = 1.1f;   // この繰り返し分の中にいる間には生産可能量は1を超えている
            if (a >= b)
            {
                un.ProductFlavor_Num++;
                if (b >= 1000.0f)            // エレメント
                {
                    NewProduct = Instantiate(uuu.Prod_ElmK_Org, new Vector3(0, 0, 0), Quaternion.identity);
                    NewProduct.GetComponent<Product>().Grade = (int)(b / 1000);        // シロップの生産量は1の倍数
                }
                else if (b >= 100.0f)       // モチ
                {
                    NewProduct = Instantiate(uuu.Prod_Moti_Org, new Vector3(0, 0, 0), Quaternion.identity);
                    NewProduct.GetComponent<Product>().Grade = (int)(b / 100);      // モチの生産量は100の倍数
                }
                else if (b >= 10.0f)        // ホイップ
                {
                    NewProduct = Instantiate(uuu.Prod_Whip_Org, new Vector3(0, 0, 0), Quaternion.identity);
                    NewProduct.GetComponent<Product>().Grade = (int)(b / 10);       // ホイップの生産量は10の倍数
                }
                else                        // シロップ
                {
                    NewProduct = Instantiate(uuu.Prod_Syrup_Org, new Vector3(0, 0, 0), Quaternion.identity);
                    NewProduct.GetComponent<Product>().Grade = (int)(b / 1);        // シロップの生産量は1の倍数
                }
                NewProduct.SetActive(false);
                NewProduct.GetComponent<Product>().uuu = this.uuu;
                NewProduct.GetComponent<Product>().Union = un;
                NewProduct.GetComponent<Product>().Born_Pos = un.transform.Find("Anim/Shadow_Pos").gameObject.transform.position.y;
                un.ProductFlavors.Add(NewProduct);
                Birth(b);
            }
            else
            {
                // 対象の生産物のグレードを１つずつ下げていく
                if (b >= 200.0f)            // 生産量が100の時は90になる
                {
                    b -= 100.0f;
                }
                else if (b >= 20.0f)        // 生産量が10の時は9になる
                {
                    b -= 10.0f;
                }
                else if (b >= 2.0f)
                {
                    b -= 1.0f;
                }
                else break;
            }
        }
        // 最後にふんばりを0にする
        // b41の仮仕様
        Umareta = Umareru;
        Umareru = 0;
        Funbari = 0;

        ui.ip.fKansei = true;
        /*if (fCoreGenB)
        {
            fCoreGenB = false;
            rCoreGenC = 0;
            PreUmareru = 0; // 次のフレームでフラグが立たないための調整
            dbg(2, 22, "× = 世代交代開始");
        }

        dbg(2, 25, "InspPop_fKanseiがKansei()でfalse");*/
    }

    // 完成してこみ上げたものを吐き出す
    // はきこみ値の処理
    void Kansei_Hakidasi(double _Umareru)
    {
        if (fHaki)
        {
            Haki += _Umareru;
            double Haki_Rate_Up = _Umareru / (Insp + 0.01f);    // はきだし率上昇

            // 
            Haki_Rate += (1 - Haki_Rate) * Haki_Rate_Up;        // 一度吐いた後が全体のインスピ量なのをお忘れなく

            if (1 - Haki_Rate < 0.01f)
            {
                Haki_Rate = 0.99f;
            }

            // スコア更新
            // 1点下駄を履く
            // はきだし率上限が99%である都合
            if (Score < (Haki_Rate * 100 + 1)
                && Komiage > 0.0001f
                && Haki_Komi > 0.0001f)
            {
                Score = Haki_Rate * 100 + 1;       // スコア更新
            }

            if (Score > 100)
            {
                Score = 100;
            }
        }
        Haki_Komi -= _Umareru;
        UpdateHakikomi();
    }

    // 生産
    // 指定された生産量を生産する
    public void Birth(double ProductAmount)
    {
        dProduct += ProductAmount;
    }

    //***********************************************************************
    //***********************************************************************
    //***********************************************************************
    //***********************************************************************
    //***********************************************************************
    //***********************************************************************
    // 生産
    // うにおんがふんばって産まれた生産物の処理
    public void Production()
    {
        // 本来ふんばれば一気に産まれるけど
        // いきなり最高速度で産まれるのではなく、少し溜めを入れる
        // 生産中のdProductを少しずつddProductに加算して少しずつ生産処理をする

        // ddProductで処理し切れていない生産物を加算しないようにする
        dddProduct = (dProduct - ddProduct) * 5.0f * dTime;
        ddProduct += dddProduct;

        // 色づきがあるけど、インスピが足りない場合は？
        if (false)
        {
            if (Insp > ddProduct * 0.1)
            {
                Insp -= ddProduct * 5.0f * dTime;

            }
            else
            {
                Insp = 0;
            }
        }

        double _DownInsp = ddProduct * 5.0f * dTime;
        // 溜め込んだ物は生産によって吐き出される
        // b50からインスピから直接吐き出される
        if (mInspMinus == ("minus"))
        {
            
            DownInsp(_DownInsp);
        }

        // b56からマイナスインスピを上げる仕様にしてみる
        if (mInspMinus == ("absorb"))
        {
            InspMinus += _DownInsp;
        }

        //Iroduki -= ddProduct * 5.0f * dTime;
        Tamekomi -= ddProduct * 5.0f * dTime;

        Product += ddProduct * 5.0f * dTime;
        dProduct -= ddProduct * 5.0f * dTime;
        //Komiage -= ddProduct * 5.0f * dTime;
        //Umareru -= ddProduct * 0.1;
        //Funbari -= ddProduct * 5.0f * dTime;
        // こみあげる量はインスピとこみあげの合計
        /*if (Iroduki < ddProduct * 0.1)
        {
            Insp -= ddProduct * 0.1;
        } else
        {
            Iroduki -= ddProduct * 0.1;
        }*/
        ddProduct -= ddProduct * 5.0f * dTime;

        Sukkiri += dSukkiri * 0.25 * dTime;
        StatSukkiri += dSukkiri * 0.25 * dTime;
        dSukkiri -= dSukkiri * 0.25 * dTime;

        //if (Komiage < 0) Komiage = 0;
        //if (Funbari < 0) Funbari = 0;
        //if (Insp < 0) Insp = 0;

        // 生産物が本当に生まれる判定（テスト）
        double ProducingAmount = 0;

        if (Producing < un.ProductFlavor_Num)  // １個生産されるまで、０も参照されない
        {
            if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "ElmK") ProducingAmount = 1000f;
            if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "Moti") ProducingAmount = 100f;
            if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "Whip") ProducingAmount = 10f;
            if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "Syrup") ProducingAmount = 1f;

            if (ProducingAmount < Product + 0.1f - Produced) // 0.1fだけ余裕を持たせる
            {
                int ProdID = 0;
                if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "ElmK")
                {
                    ProdID = 30;
                    uuu.SEProduction4.Play();
                }
                if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "Moti")
                {
                    ProdID = 20;
                    uuu.SEProduction3.Play();
                }
                if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "Whip")
                {
                    ProdID = 10;
                    uuu.SEProduction2.Play();
                }
                if (un.ProductFlavors[Producing].GetComponent<Product>().Type == "Syrup")
                {
                    ProdID = 0;
                    uuu.SEProduction.Play();
                }
                ProdID += un.ProductFlavors[Producing].GetComponent<Product>().Grade;  // モチ４なら、20+4 で 24
                un.ProductItems[ProdID]++;
                un.ProductFlavors[Producing].SetActive(true);
                Producing++;
                Produced += ProducingAmount;
            }
        }

#if b55
        // 生産物情報表示
        int[] pi = Union.ProductItems;
        Union.ProdInfo.text = "\n\n\n" + "== Product Informations ==" + "\n" +
            "Product = " + Product.ToString("F0") + "\n" +
            "ProductHeart = " + ProductHeart.ToString("F4") + "\n" +
            "Syrup : " +
                pi[1].ToString("D4") + " " + pi[2].ToString("D4") + " " + pi[3].ToString("D4") + " " + pi[4].ToString("D4") + " " + pi[5].ToString("D4") + " " +
                pi[6].ToString("D4") + " " + pi[7].ToString("D4") + " " + pi[8].ToString("D4") + " " + pi[9].ToString("D4") + "\n" +
                " Whip : " +
                pi[11].ToString("D4") + " " + pi[12].ToString("D4") + " " + pi[13].ToString("D4") + " " + pi[14].ToString("D4") + " " + pi[15].ToString("D4") + " " +
                pi[16].ToString("D4") + " " + pi[17].ToString("D4") + " " + pi[18].ToString("D4") + " " + pi[19].ToString("D4") + "\n" +
                " Moti : " +
                pi[21].ToString("D4") + " " + pi[22].ToString("D4") + " " + pi[23].ToString("D4") + " " + pi[24].ToString("D4") + " " + pi[25].ToString("D4") + " " +
                pi[26].ToString("D4") + " " + pi[27].ToString("D4") + " " + pi[28].ToString("D4") + " " + pi[29].ToString("D4") + "\n" +
                " ElmK : " +
                pi[31].ToString("D4") + " " + pi[32].ToString("D4") + " " + pi[33].ToString("D4") + " " + pi[34].ToString("D4") + " " + pi[35].ToString("D4") + " " +
                pi[36].ToString("D4") + " " + pi[37].ToString("D4") + " " + pi[38].ToString("D4") + " " + pi[39].ToString("D4") + "\n" +
                "flIncProd = " + dbgflIncProd.ToString("F2") + "\n" +
                "flLimProd = " + dbgflLimProd.ToString("F2") + "\n" +
                "";

        // 表示時間を過ぎた生産物を消去（仮）
        for (int i = Union.ProductFlavors.Count - 1; i >= 0; i--)
        {
            if (Union.ProductFlavors[i].GetComponent<Product>().TimesLeft< 0)
            {
                if (ProductFlavors[i].GetComponent<Product>().Type == "Moti") Produced -= 10.0f;
                if (ProductFlavors[i].GetComponent<Product>().Type == "Whip") Produced -= 1.0f;
                if (ProductFlavors[i].GetComponent<Product>().Type == "Syrup") Produced -= 0.1f;

                Producing--;
                ProductFlavor_Num--;

                Destroy(ProductFlavors[i]);
                Union.ProductFlavors.Remove(ProductFlavors[i]);
            }
        }
    
        // 生産ポップ処理
        // 表示時間を過ぎたポップを消去
        for (int i = 0; i < Union.ProdPops.Count; i++)
        {
            if (Union.ProdPops[i].GetComponent<ProdPop>().times< 0)
            {
                Destroy(Union.ProdPops[i]);
                Union.ProdPops.Remove(Union.ProdPops[i]);
            }
        }
#endif
    }

    // Kansei用関数
    // 完成時の生産可能量を計算する
    // ふんばりの値がすでに生産予約された生産物で枯渇してるのを考慮したり
    // インスピが切れているのに生産予約されるのを防ぐ

    double Producable()
    {
        double _Producable = Umareru - dProduct;
        // if (_Producable > Komiage_Limit) _Producable = Komiage_Limit;
        //_Producable = Mathf.Floor(_Producable);
        return _Producable;
    }

    // 完成
    void Kansei_Old()
    {
        //dProduct += (Komiage - dProduct) * 0.7;    // うにおん「こみあげた分の7割をこれから生産するよ」
        //dProduct += Funbari;    // うにおん「ふんばった分生産するうにょ」

        GameObject NewProduct;

        if (Funbari > 1.0f)
        {
            // 基本的にインスピ限界に応じた生産量ですっきりするが
            // こみ上げが少ないと、同じこみあげでもすっきりしてしまう
            // こみ上げが多い方（色づきが多い方）が有利
            double a = Funbari * (Insp_Limit / Komiage + 0.0001f);
            dSukkiri += a;
            //Debug.Log(Funbari.ToString("F3") + " 生産して " + a.ToString("F3") + " すっきりしました。");
            // (1.0f * (Iroduki - Funbari) / Insp_Limit));
            // (1.0f + (2.0f - (Iroduki - Funbari) / Insp_Limit));   // 減った後の色づき値で計算
            if (dSukkiri > Iroduki_Limit) dSukkiri = Iroduki_Limit;

            GameObject NewProdPop;

            NewProdPop = Instantiate(uuu.ProdPopOrg, new Vector3(0, 0, 0), Quaternion.identity);
            NewProdPop.GetComponent<ProdPop>().Product = Funbari;
            NewProdPop.GetComponent<ProdPop>().Sukkiri = a;
            NewProdPop.GetComponent<ProdPop>().uuu = this.uuu;
            NewProdPop.GetComponent<ProdPop>().mt = this;
            NewProdPop.GetComponent<ProdPop>().times = 1;               // 応急処置：timesが０だと表示時間なしと見なされて消去される？
            un.ProdPops.Add(NewProdPop);
        }

        if (Funbari - dProduct > 200.0f)
        {
            //Production3.Play();
            while (Funbari - dProduct > 200.0f)
            {

                // アイテムの生産
                // アイテムの出現
                //Prod_Moti_Org = (GameObject)Resources.Load("Prod_Moti");
                un.ProductFlavor_Num++;

                NewProduct = Instantiate(uuu.Prod_Moti_Org, new Vector3(0, 0, 0), Quaternion.identity);
                NewProduct.SetActive(false);
                NewProduct.GetComponent<Product>().Union = un;
                NewProduct.GetComponent<Product>().Born_Pos = un.transform.Find("Body/Shadow_Pos").gameObject.transform.position.y;
                un.ProductFlavors.Add(NewProduct);
                Birth(100.0f);
            }
        }

        if (Funbari - dProduct > 20.0f)
        {
            //Production2.Play();
            while (Funbari - dProduct > 20.0f)
            {
                un.ProductFlavor_Num++;

                NewProduct = Instantiate(uuu.Prod_Whip_Org, new Vector3(0, 0, 0), Quaternion.identity);
                NewProduct.SetActive(false);
                NewProduct.GetComponent<Product>().Union = un;
                NewProduct.GetComponent<Product>().Born_Pos = un.transform.Find("Body/Shadow_Pos").gameObject.transform.position.y;
                un.ProductFlavors.Add(NewProduct);
                Birth(10.0f);
            }
        }

        if (Funbari - dProduct > 1.0f)
        {
            //Production.Play();
            while (Funbari - dProduct > 1.0f)
            {
                un.ProductFlavor_Num++;

                NewProduct = Instantiate(uuu.Prod_Syrup_Org, new Vector3(0, 0, 0), Quaternion.identity);
                NewProduct.SetActive(false);
                NewProduct.GetComponent<Product>().Union = un;
                NewProduct.GetComponent<Product>().Born_Pos = un.transform.Find("Body/Shadow_Pos").gameObject.transform.position.y;
                un.ProductFlavors.Add(NewProduct);
                Birth(1.0f);
            }
        }

        //Komiage -= Funbari - dProduct;
        //Insp -= Funbari - dProduct;
        //Funbari -= Funbari - dProduct;

        //Iroduki -= dProduct;
        //Komiage -= dProduct;

        //gauge_grid = 0;
        //Insp = 0;                           // ミクスチャに干渉するゲージ（削除候補）
        //UI.Insp = 0;
        //Insp_Limit = Insp_Limit_Base;
    }
