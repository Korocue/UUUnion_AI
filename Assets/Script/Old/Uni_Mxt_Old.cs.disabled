    // Use this for initialization
    void Start() {
        DTimeChecker = new();
        Updated = false;

        Mix_State = false;

        Insp = Insp2 = Insp3
        = Dokidoki = Dokidoki_Cap = Funbari = Umareru = Komiage = Komiage_b = MaxKomiage = 0;
        if (uuu.TestCode == "Manjutane") Insp = 1.90;       // 初期に「考える」を起こすための初期値

        mInspMinus = "absorb";                                // マイナスインスピ吸収モード「すこしずつ吸収」
        //mInspMinus = "minus";                               // マイナスインスピ吸収モード「ただのマイナス」

        InspRaw = InspFkr = 0;

        Product = dProduct = ddProduct = dddProduct = Sukkiri = dSukkiri = 0;
        StatMix = Mix = Mix_a = Mix_b = 0;

        fFkr = true;
        isFkr = true;
        Fkr = PreFkr = FkrTmrn = FkrFl = 0;                      // ふくらみ値
        Irk = 0;                                                 // 色気付き値 

        if (uuu.TestCode == "Kurimanju") Iroduki = 16;
        if (uuu.TestCode == "Manjutane") Iroduki = 0;
        Iroduki_Increase = 0.01;        // フレーバーによる色づき上昇
        Iroduki_IncreaseLimit = 0;      // フレーバーによる色づき上昇限界（現在用途不明）
        StatIrodukiAbsorbInsp = 0;
        Tamaran = 0;

        // ためこみ限界値の初期上限
        // 初期はこのレベルまでの生産が可能
        Gaman = 0.1f;                                           // 初期は10%（1%のミックス10回分）
        Gaman_Limit = 1;                                        // がまん値の上限（1%のミックスを100回分）
        Gaman_p = 0;                                            // がまん値は0除算を防ぐために0.1の下駄を履いている
        Gaman_Limit_p = 0;                                      // _p値はその下駄を取り除いたもの

        // Raw値、Fkr値もそれぞれリセット
        GamanRaw = GamanFkr = GamanRaw_p = GamanFkr_p
        = GamanRaw_Limit = GamanFkr_Limit = GamanRaw_Limit_p = GamanFkr_Limit_p = 0;

        Tamekomi_Limit_Base = Tamekomi_Limit = 1;
        Iroduki_Limit_Base = Iroduki_Limit = Tamekomi_Limit;
        //Iroduki_Limit_Base = Iroduki_Limit = 20;
        //Insp_Limit_Base = Iroduki_Limit * 0.1;  // 竿より玉にいっぱい貯められる
        //Gaman_Limit = Iroduki_Limit;
        Insp_Limit_Base = Iroduki_Limit;
        Insp_Limit = Insp_Limit_Base2 = Insp_Limit_Base;
        Iroduki_Capacity = 100;                         // 色づきがインスピの何倍を吸収できるか（初期は100倍の設定だった）
        Iroduki_ChildPop = new List<_Iroduki_ChildPop>();

        MixStrength = 1;                                // ミクスチャの強さ
        Pre_Mix = MixStrength;
        Pre_Mix_Bonus = 0;
        Fl_Mix = Fl_Mix_Max = MixStrength * 100;        // ミクスチャフレーバー値

        bkht = new(un);

        fHaki = true;
        if (mInspMinus == "absorb") fHaki = false;
        Funbari_Limit = 100;                                // 仮
        Komiage_Limit = 100;
        // ProductItems = new int[50];                         // シロップ９種、ホイップ９種、モチ９種、その他予備
        // for (int i = 0; i < 50; i++) Union.ProductItems[i] = 0;
        un.ProductFlavor_Num = 0;                              // 生産物フレーバー
        un.ProductFlavors = new List<GameObject>();            // 生産物フレーバー配列初期化
        //ProductFlavors = new GameObject[0];               // 空の配列
        Producing = 0;
        Produced = 0;
    }

    //***********************************************************************
