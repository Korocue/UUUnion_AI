                    dTime;

                dProduct += 0.02 *
                    InspOverRatio *                                     // 超過した分のみ
                    FlavorGaman *                   // 超過量に対してガマンした分だけ生産が抑えられる
                    dTime;
                // 秒間 0.01 の生産

                // 生産した分だけガマン強さが低下する
                Gaman_Exp -= 0.02 *
                    FlavorGaman *                   // 超過量に対してガマンした分だけガマン強さの低下が抑えられる
                    0.1 *                                               // 補正値 10%
                    dTime;

                Gaman -= (1 - FlavorGaman) * 0.02 * dTime;       // 生産量を抑えた分だけガマンを消費する
                Gaman_Exp += (1 - FlavorGaman) * 0.02 * dTime;   // 生産を抑えた分だけガマン強さが上昇する
            }*/

            // 見る
            // 0.03の速度でインスピが溜まり、0.05の速度で生産する
            if (Insp > 0.05 * 100)
            {
                double InspOver = Insp - 0.05 * 100;                    // 「考える」のためのインスピ超過量
                double InspOverRatio = EasyMath.Yeast(InspOver / (0.05 * 100));

                uuu.FlavorLook.Level = InspOverRatio;

                // 「考える」と0.03の速度でインスピレーションが溜まる
                // ただし超過した分のみ・考えるのをガマンした分は抑えられる
                Insp += 0.03 *
                    InspOverRatio *                                     // ただし超過した分のみ
                    EasyMath.Gaman(InspOver, Gaman) *                   // 考えるのをガマンした分は抑えられる
                    (1 + Gaman * 0.01) *                                // ガマンの1%の進行速度でインスピレーションが溜まる
                    dTime;

                Birth(0.05 *
                    InspOverRatio *                                     // 超過した分のみ
                    EasyMath.Gaman(InspOver, Gaman) *                   // 超過量に対してガマンした分だけ生産が抑えられる
                    dTime);
                // 秒間 0.01 の生産

                // 生産した分だけガマン強さが低下する
                // Gaman_Exp -= 0.05 *
                //    EasyMath.Gaman(InspOver, Gaman) *                   // 超過量に対してガマンした分だけ低下が抑えられる
                //    0.1 *                                               // 補正値 10%
                //    dTime;

                // Gaman -= (1 - EasyMath.Gaman(InspOver, Gaman)) * 0.05 * dTime;       // 生産量を抑えた分だけガマンを消費する
                // Gaman_Exp += (1 - EasyMath.Gaman(InspOver, Gaman)) * 0.05 * dTime;   // 生産を抑えた分だけガマン強さが上昇する
            }
            // if (Gaman_Exp < 0) Gaman_Exp = 0;
            // Gaman_Level = 0.01 * Mathf.Sqrt((float)(Gaman_Exp / 10.00f)); // ガマンレベル計算式
