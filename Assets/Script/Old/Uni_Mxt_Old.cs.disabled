                * dTime;
            // 爆発が近いと補正が強くなる
            Insp_Loss +=
                Insp
                * (1 - EasyMath.PowCurve(Iroduki, 2f, Iroduki_Limit))
                * EasyMath.PowCurve(Insp_Rate(), 0.5f, 1)
                * 0.5f
                * dTime;*/
            // ためこみ値が溜まっていればその分色づきに吸収される
            // ためこみ値がないとインスピが抑えられないことになる
            //Insp_Loss *= ((Tamekomi - Iroduki) / Tamekomi_Limit);
            //if (Insp_Loss > Insp) Insp_Loss = Insp;
        }
        if (uuu.TestCode == "Manjutane")
        {
            // がまん値は実質限界値100倍の量のインスピを溜め込める
            // インスピを溜め込む割合は色づきによって決まる
            //Insp_Loss = Insp * 0.010 * (1 - EasyMath.PowCurve(Gaman, 2.0f, Gaman_Limit));
            //Gaman += Insp_Loss * 0.01 * (1 - EasyMath.PowCurve(Iroduki, 2.0f, Iroduki_Limit));
            //Gaman *= 0.9999;
        }

        // インスピ吸収
        // インスピ値を一時的に上位のインスピ値に吸収させる
        // 最終的に色づき値が上がると逃げ場所が無くなり
        //バクハツ発が避けられなくなる

        double insp_a;
        double loss;
        double cutoff = 0;
        float rate = 5 / 1.0f;
        //float rate = dTime / 1.0f;
        float dstpow = 5;

        //IrodukiAbsorb(Absorb(Insp3, Iroduki, Iroduki_Limit, (1 / 5.0f), 2, ref cutoff));
        //Insp3 -= Absorb(Insp3, Iroduki, Iroduki_Limit, (1 / 5.0f), 2, ref cutoff);

        //rate = 10 / 1.0f;
        //loss = Absorb_Cutoff(Insp2, Insp3, Iroduki_Limit, (1 / 1.0f), 2, ref cutoff);
        //IrodukiAbsorb(loss);

        // insp3の吸収処理
        if (false)
        {
            loss = Absorb(Insp3, Iroduki, Iroduki_Limit, rate, dstpow);
            IrodukiAbsorb(loss);
            Insp3 -= loss;
        }
        //Insp3 += Absorb(cutoff, Insp3, Iroduki_Limit, (1 / 1.0f), 2);
        //Insp2 -= Absorb(cutoff, Insp3, Iroduki_Limit, (1 / 1.0f), 2);

        //IrodukiAbsorb(Insp_Loss(Insp2));
        //Insp3 += Absorb(Insp2, Insp3, Iroduki_Limit, (1 / 3.0f), 2, ref cutoff);
        //Insp2 -= Absorb(Insp2, Insp3, Iroduki_Limit, (1 / 3.0f), 2, ref cutoff);

        // insp2の吸収処理
        if (false)
        {
            insp_a = Insp2 - Insp3;
            //rate = 10 / 1.0f;
            loss = Absorb_Cutoff(insp_a, Iroduki, Iroduki_Limit, rate, dstpow, ref cutoff);
            IrodukiAbsorb(loss);
            Insp2 -= loss;
            Insp3 += Absorb(cutoff, Insp3, Iroduki_Limit, rate, dstpow);
            Insp2 -= Absorb(cutoff, Insp3, Iroduki_Limit, rate, dstpow);
        }
        //IrodukiAbsorb(Insp_Loss(Insp1));
        //Insp2 += Absorb(Insp1, Insp2, Iroduki_Limit, (1 / 2.0f), 2, ref cutoff);
        //Insp1 -= Absorb(Insp1, Insp2, Iroduki_Limit, (1 / 2.0f), 2, ref cutoff);

        // insp1からの吸収処理
        if (false)
        {
            insp_a = Insp1 - Insp2;
            //rate = 10 / 1.0f;
            loss = Absorb_Cutoff(insp_a, Iroduki, Iroduki_Limit, rate, dstpow, ref cutoff);
            IrodukiAbsorb(loss);
            Insp1 -= loss;
            Insp2 += Absorb(cutoff, Insp2, Iroduki_Limit, rate, dstpow);
            Insp1 -= Absorb(cutoff, Insp2, Iroduki_Limit, rate, dstpow);
        }

        // inspからの吸収処理
        if (false)
        {
            // inspからinsp1に吸収する？
            if (false)
            {
                insp_a = Insp - Insp1;
                //rate = 10 / 1.0f;
                loss = Absorb_Cutoff(insp_a, Iroduki, Iroduki_Limit, rate, dstpow, ref cutoff);
                IrodukiAbsorb(loss);
                Insp -= loss;
                Insp1 += Absorb(cutoff, Insp1, Iroduki_Limit, rate, dstpow);
                Insp -= Absorb(cutoff, Insp1, Iroduki_Limit, rate, dstpow);
            }
            // inspからinsp1に吸収せず
            // そのまま色づきへ吸収させる
            else
            {
                loss = Absorb(Insp, Iroduki, Iroduki_Limit, rate, dstpow);
                IrodukiAbsorb(loss);
                Insp -= loss;
            }
        }


        /*IrodukiAbsorb(Insp_Loss(Insp3));
        Insp3 -= Insp_Loss(Insp3);

        //IrodukiAbsorb(Insp_Loss(Insp2));
        Insp3 += Insp_Loss(Insp2);
        Insp2 -= Insp_Loss(Insp2);

        //IrodukiAbsorb(Insp_Loss(Insp1));
        Insp2 += Insp_Loss(Insp1);
        Insp1 -= Insp_Loss(Insp1);

        //IrodukiAbsorb(Insp_Loss(Insp));
        Insp1 += Insp_Loss(Insp);
        Insp -= Insp_Loss(Insp);*/

        // 仮処理
        // insp3（チャンネル3）のみ使用



        //if (Insp1_Rate > 1) Insp1_Rate = 1;
        //Insp1 += UpInsp * Insp1_Rate;

        //Insp -= Insp_Loss(Insp);

        //Insp1 -= Insp_Loss(Insp1);
        //Insp2 -= Insp_Loss(Insp2);

        /*
        double Insp3_Loss = Insp_Loss(Insp3, true);
        Insp3 -= Insp3_Loss;
        Insp += Insp3_Loss;

        // インスピ0値の処理
        // Insp_LossはdTime適用済
        double Insp0_Loss = Insp_Loss(Insp);

        // 90% - 180%
        // 0.9で100%になる
        float Insp3_Rate = (float)((Insp / Insp_Limit) - 0.9) * (1.0f / 0.9f);
        if (Insp3_Rate < 0)
        {
           Insp3_Rate = 0;
        }

        Insp3 += Insp0_Loss * Insp3_Rate;
        Insp -= Insp0_Loss * Insp3_Rate;        

        // 色づき吸収
        Insp -= Insp0_Loss;
        IrodukiAbsorb(Insp0_Loss);*/

        StatKeepInsp += (Insp / 20000) * dTime;                     // インスピレーション維持指数によってインスピ限界値がゆっくりインフレする
                                                                    // Iroduki -= dMixSukkiri * 0.02f * (mipr);

        // 吸い上げる値が枯渇したら普通に増える
        /*if (Iroduki < 0)
        {
            Insp += -Iroduki;
            Iroduki = 0;
        }*/
    }
    void UpdateInspLimit()
    {
        // b50
        // 暫定処理
        Insp_Limit_Base2 = Gaman;
        //Insp_Limit_Base2 = Iroduki_Limit / Iroduki_Capacity;
        //Insp_Limit_Base2 = 1.0f;
        //Insp_Limit_Base2 = Insp_Limit_Base + (float)(StatSukkiri / 10) / 2;
        // インスピ限界をたまらん値で引くということは
        // 結局のところインスピ値にたまらん値を足すのと同じことになる
        // そうなるとインスピ値にたまらん値を足すことで
        // バクハツ制御に使うようにした方が良いか？
        // × Insp_Limit = Insp_Limit_Base2 - Tamaran;
        // 〇 Insp_Limit = Insp_Limit_Base2;
        Insp_Limit = Insp_Limit_Base2;
    }

    // フレーバー参照用メソッド
    // Fl(n)というフォーマットのみでフレーバーを参照出来る
    public Flavor Fl(int n)
    {
        return un.Fl.list[n];
    }

    void UpdateFlavor()
    {
        if (un.Fl == null)
        {
            un.Fl_List_Construct();
        }

        // フレーバーで色気づく
        if (un.Fl.Count() != 0)
        {
            Irk += Fl(0).Absorb(Fl(0) * 0.01f * dTime);
            // クールダウン0.01%（3時間くらいかかる）
            // そうでなくても長ければ長いほど機能が回復する
            Fl(0).value += (Fl(0).max - Fl(0).value) * 0.0001f * dTime;
        }

        // フレーバークールダウン
        Fl_Mix_Max = MixStrength * 100;

        //Fl_Mix_Irk -= Fl_Mix_Irk * 0.01f * dTime;

        // 1%の消費に対してクールダウンはさらに1%(0.01%)
        Fl_Mix += (Fl_Mix_Max - Fl_Mix) * 0.0001f * dTime;

        if (Fl_Mix < 0) Fl_Mix = 0;
        if (Fl_Mix > Fl_Mix_Max) Fl_Mix = Fl_Mix_Max;
    }

    void UpdateMix()
    {
        double a = 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
        double b = MixStrength * 0.5f;
        double bi = MixStrength * 0.5f;                   // 色気づきの影響を受けたミクスチャ強度 

        // 押し下げ値(c-down値)
        // プリミクスチャ値は0.2秒で補充される(c-up値)
        // 注意：Pre_Mixは0-1の値
        double cdn = Pre_Mix * a;                         // プリミクスチャ消費量
        double cup = (1 - Pre_Mix) * 5.0f * dTime;        // プリミクスチャ補充量

        // ミクスチャを押し付けた状態でミクスチャが増加
        if (un.mix_state == 1)
        {
            Mix_State = true;
            // すっきり値が適用された単位時間当たりの増加量

            // 色気づき増加
            // 1回の押し付けでミックスフレーバー値の1%、色気づきが増加する
            // ※Pre_Mixの値はPre_Mixと違い、ミクスチャ強度の適用されていない0-1の範囲の値となる

            // フレーバー値から色気づきに変換
            // インスピ量に応じて補正が0.5から1.5の範囲でかかる
            //Fl_Mix_Irk += Pre_Mix * (Fl_Mix - Fl_Mix_Irk) * 0.01f * a;
            dIrk += cdn * 0.5f * Fl_Mix * 0.01f;
            //dIrk += Pre_Mix * 0.5f * Fl_Mix
            //* (Insp_Rate(Insp) + 0.5f)
            //    * 0.01f * a;
            //Fl_Mix_Irk_Insp = Fl_Mix_Irk + Insp;    // 補正

            // この辺が少し問題
            // フレーバー値のうち、色気づき値に割り当てられた分は
            // フレーバー値から消費されない
            // 代わりにフレーバー値を消費したうち
            // 割り当てたフレーバー値と、フレーバー値本体の両方から引かなければならない
            //Fl_Mix_Irk -= Pre_Mix * Fl_Mix_Irk_Insp * 0.01f * a;
            //Fl_Mix -= Pre_Mix * Irk_Insp * 0.01f * a;
            Fl_Mix -= cdn * 0.5f * Fl_Mix * 0.01f;
            //Fl_Mix -= Pre_Mix * 0.5f * Fl_Mix
            //* (Insp_Rate(Insp) + 0.5f)
            //    * 0.01f * a;
            // 補正を受けるが、消費する値も大きくなる

            // 色気づき値からミクスチャ値に変換
            // 補正が1.5から0.5の範囲でかかる
            // 前半は供給が遅く、消費が速い
            // 後半は供給が速く、消費が遅い
            //Mix += Pre_Mix * Irk
            //    * (1 - Iroduki_Rate() + 0.5f)
            //    * 0.01f * a;
            //Irk -= Pre_Mix * Irk
            //    * (1 - Iroduki_Rate() + 0.5f)
            //    * 0.01f * a;

            // 色気づきが少ない時
            if (Irk < 0)
            {
                // 現在色気づきによる減衰は停止中
                // bi = (MixStrength * 0.5f) + (Irk * 0.01f);
            }

            // ミックス
            Mix += cdn * b;
            // Mix += cdn * (MixStrength * 0.5f);

            // ミックスによる色気づきボーナス
            // Mix += cdn * bi;
            // Irk -= cdn * bi;

            Pre_Mix -= cdn;

            // 押し付けるとプリミクスチャからポンプのようにミクスチャ値に値が送り込まれる
            // （0.2秒で100%のペース）

            //Mix += Pre_Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
            //Pre_Mix -= Pre_Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
        }
        // ミクスチャ値からデルタミクスチャに変換して消費する（0.2秒で変換）
        // 完成に近づくほど、刺激が弱くなる（旧ソースの仕様）
        // dMix += Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
        // Mix -= Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
        dMix += Mix * 5.0f * dTime;
        Mix -= Mix * 5.0f * dTime;

        // プリミクスチャ値からミクスチャ値を消費する
        // この値はすっきり値の影響を受けないため、すっきり中は消費が無駄になる
        //Pre_Mix -= Mix * 2.0f * dTime * Mathf.Pow(1 - Sukkiri_Rate(), 5);

        // Pre_Mix_Bonus += dPre_Mix_Bonus * 5.0f * dTime;
        // dPre_Mix_Bonus += dPre_Mix_Bonus * 5.0f * dTime;
        // Pre_Mix_Bonus -= Pre_Mix_Bonus * 5.0f * dTime;
        //}

        // ミクスチャを離した状態でプリミクスチャが補充される
        if (un.mix_state == 0)
        {
            // 色気づきが少ない時
            if (Irk < 0)
            {
                // 現在色気づきによる減衰は停止中
                // bi = (MixStrength * 0.5f) + (Irk * 0.01f);
            }
            if (Mix_State)
            {
                // インスピ上昇ポップ表示後、計測値をリセット
                //double d = (1 - Pre_Mix) * (b + bi);
                double d = (1 - Pre_Mix) * (b + 0f);
                // d : こすり上げで上がるインスピの予測値
                if (dUpInspPop + d >= 0)
                {
                    ui.UpInspPop(dUpInspPop + d);
                    dUpInspPop = -d;
                }
                else
                {
                    // 予測値が消費される前に次のミックスをすると次の表示がマイナスになる
                    // その時はマイナス値を持ち越し（いつかは消費される）
                    ui.UpInspPop(0);
                    dUpInspPop = -d - (dUpInspPop + d);
                }

            }
            Mix_State = false;

            if (true)
            {
                dIrk += cup * 0.5f * Fl_Mix * 0.01f;
                Fl_Mix -= cup * 0.5f * Fl_Mix * 0.01f;

                // ミックス（こすり上げ）
                Pre_Mix_Bonus += cup * b;
                //Pre_Mix_Bonus += cup * (MixStrength * 0.5f);

                // ミックスによる色気づきボーナス
                // Pre_Mix_Bonus += cup * bi;
                // Irk -= cup * bi;

                Pre_Mix += cup;
            }

            // プリミックス値は0.2秒で補充される
            if (Pre_Mix < 0) Pre_Mix = 0;
            if (Pre_Mix < 1)
            {
                //Pre_Mix += (1 - Pre_Mix) * 5.0f * dTime;
                // こすり上げボーナスにより、補充分の100%がミクスチャ値に変換される
                //Mix += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;
                // ミクスチャポップに反映させるための値（白い枠が少し膨らむ）
                //dPre_Mix_Bonus += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;

            } else
            {
                Pre_Mix = 1;
            }

            // プリミクスチャ値は0.2秒で補充される
            // 注意：Pre_Mixは0-1の値
            if (Pre_Mix < 1)
            {
                //Pre_Mix += (1 - Pre_Mix) * 5.0f * dTime;
                // こすり上げボーナスにより、補充分の100%がミクスチャ値に変換される
                //Mix += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;
                // ミクスチャポップに反映させるための値（白い枠が少し膨らむ）
                //dPre_Mix_Bonus += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;

            }
            // プリミクスチャボーナス
            //Pre_Mix += Pre_Mix_Bonus * 2.0 * dTime;
            //Pre_Mix_Bonus -= Pre_Mix_Bonus * 2.0 * dTime;
            //Pre_Mix_Bonus += dPre_Mix_Bonus * 2.0 * dTime;
            //dPre_Mix_Bonus -= dPre_Mix_Bonus * 2.0 * dTime;
            //Pre_Mix_Bonus -= Pre_Mix_Bonus * 1.0 * dTime;
        } else
        {
            // 押し付けたままでもちょこっと補充される
            // 定数が5.0fではなく、0.5fとなっている（0.2秒ではなく、0.02秒ペース）
            if (Pre_Mix < 0) Pre_Mix = 0;
            if (Pre_Mix < 1)
            {
                Pre_Mix += (1 - Pre_Mix) * 0.5f * dTime;
                // こすり上げボーナスにより、補充分の100%がミクスチャ値に変換される
                //Mix += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;
                // ミクスチャポップに反映させるための値（白い枠が少し膨らむ）
                //dPre_Mix_Bonus += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;

            }
            else
            {
                Pre_Mix = 1;
            }

            // 押し付けたままでもちょこっと補充される
            Pre_Mix += (1 - Pre_Mix) * 0.5f * dTime;

            // 押し付けたままでも10%まで補充される
            //if (Pre_Mix < (MixStrength * 0.1f))
            //{
            //    Pre_Mix += ((MixStrength * 0.1f) - Pre_Mix) * 5.0 * dTime;
            //}
        }

        //if (Union.mix_state == 0)
        if (false)
        {
            dIrk += (1 - Pre_Mix) * 0.5 * Fl_Mix
                * 0.01f;

            Fl_Mix -= (1 - Pre_Mix) * 0.5 * Fl_Mix
                * 0.01f;

            Mix += MixStrength * 0.5 * (1 - Pre_Mix);
            dIrk -= MixStrength * 0.5 * (1 - Pre_Mix); // 色気づき消費
            dPre_Mix_Bonus += (1 - Pre_Mix) * 0.5;
            //Mix += (MixStrength - Pre_Mix) * 0.5;
            //dPre_Mix_Bonus += (MixStrength - Pre_Mix) * 0.5;
        }

        // プリミックスボーナス
        //Pre_Mix_Bonus += dPre_Mix_Bonus * 1.0f * dTime;
        //dPre_Mix_Bonus -= dPre_Mix_Bonus * 1.0f * dTime;
        //Pre_Mix_Bonus += dPre_Mix_Bonus * 5.0f * dTime;
        //dPre_Mix_Bonus -= dPre_Mix_Bonus * 5.0f * dTime;
        //Pre_Mix_Bonus -= Pre_Mix_Bonus * 5.0f * dTime;

        // プリミックスボーナスの消費
        dPre_Mix_Bonus = Pre_Mix_Bonus * 5.0f * dTime;
        dMix += dPre_Mix_Bonus;
        Pre_Mix_Bonus -= dPre_Mix_Bonus;

        // ddMixで実際の消費が行われる（秒間100%）
        ddMix = dMix * 5.0f * dTime;

        // すっきりしているとミクスチャ値のロスが発生する
        // 少しでもすっきりしてるとミクスチャがかなり弱くなる
        //ddMixSukkiri = ddMix * Mathf.Pow(1 - Sukkiri_Rate(), 5);
        ddMixSukkiri = ddMix;

        //Mix -= ddMix;
        //dMix -= ddMix;

        Mix -= ddMix;
        dMix -= ddMix;
        dMix -= 0;

        dUpInspPop += ddMix;                                // インスピ上昇テキスト生成用計測値（生成時0にリセットされる）

        if (ddMix < 0) ddMix = 0;
        if (dMix < 0) dMix = 0;
        if (Mix < 0) Mix = 0;
        StatMix += dMix * dTime;                            // 総ミクスチャ量（すっきりに依存しない、とにかくこすれ！）

        // dMixの最低値を計算
        // ミックスに慣れて、この最低値である程度無効化する
        // しかしその分ミックス強度に応じて倍率が上がる
        // ミックスをしないと一瞬で最低値が戻る
        if (dMix < dMix_Min) dMix_Min -= (dMix_Min - dMix) * 5.0 * dTime;
        if (dMix > dMix_Min) dMix_Min -= (dMix_Min - dMix) * 0.5 * dTime;

        // 以下ミックスポップ更新処理から移動
        // 正しく解読出来てない
        if (true)
        {
            // プリミックス最大値を元に戻す？
            if (Pre_Mix > Pre_Mix_Max) Pre_Mix_Max -= (Pre_Mix_Max - Pre_Mix) * 5.0 * dTime;
            if (Pre_Mix < Pre_Mix_Max) Pre_Mix_Max -= (Pre_Mix_Max - Pre_Mix) * 1.0 * dTime;

            // プリミックスボーナス最大値を元に戻す？
            double Pre_BMix = Pre_Mix + Pre_Mix_Bonus;

            if (Pre_BMix > Pre_BMix_Max) Pre_BMix_Max -= (Pre_BMix_Max - Pre_BMix) * 5.0 * dTime;
            if (Pre_BMix < Pre_BMix_Max) Pre_BMix_Max -= (Pre_BMix_Max - Pre_BMix) * 1.0 * dTime;
        }
    }

    void UpdateMix_b48()
    {
        // ミクスチャを押し付けた状態でミクスチャが増加
        if (un.mix_state == 1)
        {
            // 押し付けるとプリミクスチャからポンプのようにミクスチャ値に値が送り込まれる
            // （0.2秒で100%のペース）
            Mix += Pre_Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
            Pre_Mix -= Pre_Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
        }
        // ミクスチャ値からデルタミクスチャに変換して消費する（0.2秒で変換）
        // 完成に近づくほど、刺激が弱くなる（旧ソースの仕様）
        dMix += Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);
        Mix -= Mix * 5.0f * dTime * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5);

        // プリミクスチャ値からミクスチャ値を消費する
        // この値はすっきり値の影響を受けないため、すっきり中は消費が無駄になる
        //Pre_Mix -= Mix * 2.0f * dTime * Mathf.Pow(1 - Sukkiri_Rate(), 5);

        // Pre_Mix_Bonus += dPre_Mix_Bonus * 5.0f * dTime;
        // dPre_Mix_Bonus += dPre_Mix_Bonus * 5.0f * dTime;
        // Pre_Mix_Bonus -= Pre_Mix_Bonus * 5.0f * dTime;
        //}

        // ミクスチャを離した状態でプリミクスチャが補充される
        if (un.mix_state == 0)
        {
            // プリミクスチャ値は0.2秒で補充される
            if (Pre_Mix < MixStrength)
            {
                Pre_Mix += (MixStrength - Pre_Mix) * 5.0 * dTime;
                // こすり上げボーナスにより、補充分の100%がミクスチャ値に変換される
                //Mix += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;
                // ミクスチャポップに反映させるための値（白い枠が少し膨らむ）
                //dPre_Mix_Bonus += 1.0f * (MixStrength - Pre_Mix) * 5.0 * dTime;

            }
            // プリミクスチャボーナス
            //Pre_Mix += Pre_Mix_Bonus * 2.0 * dTime;
            //Pre_Mix_Bonus -= Pre_Mix_Bonus * 2.0 * dTime;
            //Pre_Mix_Bonus += dPre_Mix_Bonus * 2.0 * dTime;
            //dPre_Mix_Bonus -= dPre_Mix_Bonus * 2.0 * dTime;
            //Pre_Mix_Bonus -= Pre_Mix_Bonus * 1.0 * dTime;
        }
        else
        {
            // 押し付けたままでもちょこっと補充される
            Pre_Mix += (MixStrength - Pre_Mix) * 0.5 * dTime;

            // 押し付けたままでも10%まで補充される
            //if (Pre_Mix < (MixStrength * 0.1f))
            //{
            //    Pre_Mix += ((MixStrength * 0.1f) - Pre_Mix) * 5.0 * dTime;
            //}
        }

        // プリミクスチャボーナス
        Pre_Mix_Bonus += dPre_Mix_Bonus * 5.0f * dTime;
        dPre_Mix_Bonus -= dPre_Mix_Bonus * 5.0f * dTime;
        Pre_Mix_Bonus -= Pre_Mix_Bonus * 5.0f * dTime;

        // ddMixで実際の消費が行われる（秒間100%）
        ddMix = dMix * 1.0f * dTime;


        // すっきりしているとミクスチャ値のロスが発生する
        // 少しでもすっきりしてるとミクスチャがかなり弱くなる
        //ddMixSukkiri = ddMix * Mathf.Pow(1 - Sukkiri_Rate(), 5);
        ddMixSukkiri = ddMix;

        //Mix -= ddMix;
        //dMix -= ddMix;

        Mix -= ddMix;
        dMix -= ddMix;
        dMix -= 0;


        if (ddMix < 0) ddMix = 0;
        if (dMix < 0) dMix = 0;
        if (Mix < 0) Mix = 0;
        StatMix += dMix * dTime;                            // 総ミクスチャ量（すっきりに依存しない、とにかくこすれ！）
    }

    void UpdateMixStrength()
    {
        // ミクスチャ強度は最終的に色づき吸収率で変化させることも考えてる
        if (StatMix > 0)
        {
            MixStrength = 0.01
             +
                (
                    Mathf.Pow((float)StatMix / 1000, 0.5f) +            // 総ミクスチャ量に基づいてインスピ許容値がインフレ
                    (Iroduki_IncreaseLimit / 100)                       // フレーバーの１％だけミクスチャが強化される
                ) * 0.01;                                               // それを1%
        }
        // マイナス用の処理も（イレギュラー用の処理）
        else
        {
            MixStrength = 0.01
            -
               Mathf.Pow((float)-StatMix / 1000, 0.5f) +          // 総ミクスチャ量に基づいてインスピ許容値がインフレ
               (Iroduki_IncreaseLimit / 100);                        // フレーバーの１％だけミクスチャが強化される
        }

        // ムードで2倍化
        MixStrength *= (1 + uuu.Mood);
    }

    // 色気付き更新処理
    void UpdateIrk()
    {
        // デルタ色気づきから、色気づき本体へ移動
        Irk += dIrk * 1.0f * dTime;
        dIrk -= dIrk * 1.0f * dTime;

        // 色気づき減衰
        // インスピが溜まれば溜まるほど減衰しない
        //Irk -= Irk * 0.01f * (1 - Insp_Rate(Insp)) * dTime;

        // インスピ補正
        Irk_Insp = Irk + (Irk * Insp_Rate(Tamaran)) + (Komiage);
        //Irk_Insp = Irk + (Irk * Insp_Rate(Tamaran)) + (Tamaran * Insp) + (Komiage);
        //Irk_Insp = Irk + (Irk * Insp_Rate(Tamaran)) + (Tamaran * Iroduki * 100) + (Komiage * 100);
        // かなり複雑になった
        // インスピで補正がかかるが、そこにさらに溜め込み補正もかかる

        // Irk_Insp = ((Irk_Insp + (Insp_Limit * 100)) * Mathf.Pow(Sukkiri_Invalid_Rate_C(1, 1), 5)) - (Insp_Limit * 100);
        // インスピ補正をかけた値ですっきり補正をかける
        // すっきりしてるのに無駄にこすらない
        // またすっきりしてもこみ上げてる間はこすり続ける
        // インスピ上限を足して割った後、また引く（すっきりでマイナスに近づける）

        //Union.SetIrk(1);
        if (Irk_Insp + InspVolume() > Gaman)
        {
            // Union.SetIrk(1);
            // Union.irk_automix_time = (float)(4.8f / (1 + (Irk_Insp / ((Gaman * 10) / 9)))) + 0.2f;
            // Irk_inspが
            // Gaman * 10に到達した場合に自動インスピ感覚が0.5f（分母が10になる）
        } else
        {
            if (Irk_Insp + InspVolume() < (Gaman * 0.5f))
            {
                //Union.SetIrk(0);
            }
        }
        un.irk_automix_time = (float)(4.8f / (1 + (Irk_Insp / ((Gaman * 10) / 9)))) + 0.2f;
    }

