            if (Insp2 / Insp_Limit > 1)
            {
                float Insp3_Rate = (float)((Insp2 / Insp_Limit) - 0.9) * (1.0f / 1.1f);
                if (Insp3_Rate > 1) Insp3_Rate = 1;
                Insp3 += UpInsp * Insp3_Rate;
            }*/
        }

        // (まんじゅうたね)
        // インスピは常時増加
