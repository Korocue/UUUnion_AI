    // Update is called once per frame
    void Update() {

        UpdateInit();

        Sukkiri = 0;                    // 現在すっきり無効化中

        UpdateInsp();                   // インスピ処理
        UpdateInspLimit();              // インスピ上限値更新
        UpdateFlavor();                 // フレーバー処理
        UpdateMix();                    // ミックス処理
        UpdateMixStrength();            // ミクスチャの強さ更新
        UpdateDokidoki();               // どきどき値
        UpdateIrk();                    // 色気づき
        UpdateGaman();                  // がまん値
        UpdateGamanLimit();             // がまん限界
        
        UpdateIrodukiLimit_Kurimanju(); // 旧色づき更新（廃止予定？）
        UpdateIroduki();                // 色づき更新（廃止予定？）
        UpdateTamekomi();               // ためこみ値（未使用？）
        UpdateTamekomiLimit();          // ためこみ限界（未使用？）

        UpdateFkr();                    // ふくらみ値
        UpdateBakuhatuParam();          // バクハツ系パラメータ更新
        Production();

        // UIにインスピレーションの数値を反映する
        // UI.Insp = Insp;
        Mix_a *= 0.99;

        // ここでDebugInfoのテキストを更新
        UpdateDebugText();
        Updated = true;
    }

    // Update用前処理
    // dTimeやトレースモードなどの処理
    void UpdateInit()
    {
        // アプデ毎に1回読まないと大変なことになる
        if (DTimeChecker == null) DTimeChecker = new();
        dTime = DTimeChecker.GetDeltaTime();

        // トレースモードの場合
        // UnionのdTimeは0になったり1フレームになったりする
        // Union.cs内でフレーム送りの処理があり
        // そこで逐次dTimeに進める時間を設定してコマ送りをする
        if (!uuu.ModeTrace)
        {
            //dTime = Time.deltaTime;
        }
        else
        {
            dTime = uuu.dTime;
        }

        // カクツキが発生した場合にブレークポイントを設定する
        if (dTime > 1.0f / 15)
        {
            dTime = 1.0f / 15;
            // 15fps以上で極端な数字は丸める
        }

        // デバッグ文字列配列の再生成
        uuu.CheckDebugArray();
    }

    // ミックスする
    // b59現在何もしない
    public void DoMix()
    {
        // Mix_a += Mix;

        //this.Mix += MixStrength / 2;
        // こすり上げとこすり上げのセットでMixStrengthと等価に


        // プリミクスチャ値を消費してミックスを行う
        // こすり下げとこすり上げのセットでMixStrengthと等価に
