            // 警告
            if (Insp > 0.01 * 100)
            {
                double InspOver = Insp - 0.01 * 100;                    // 「警告」のためのインスピ超過量
                Birth(0.01 *
                    EasyMath.Gaman(InspOver, Gaman) *                   // 超過量に対してガマンした分だけ生産が抑えられる
                    dTime);
                // 秒間 0.01 の生産

