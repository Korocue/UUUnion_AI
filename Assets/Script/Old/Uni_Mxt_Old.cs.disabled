    // ためこみ率
    public float Tamekomi_Rate()
    {
        return (float)(Tamekomi / Tamekomi_Limit);
    }

    // パーセンテージからインスピ値を取得する
    public double RateToInsp(double r)
    {
        return Gaman * (r / 100);
    }

    // パーセンテージから色づき値を取得する
    public double RateToIroduki(double r)
    {
        return Iroduki_Limit * (r / 100);
    }

    // パーセンテージからためこみ値を取得する
    public double RateToTamekomi(double r)
    {
        return Tamekomi_Limit * (r / 100);
    }
    void UpdateFkr()
    {
        dbg(0, 15, "■ふっくら");

        // ふっくら値は
        // フレーバーとたまらん値が影響する
        Fkr = FkrTmrn + FkrFl;

        // ムードで2倍化
        Fkr *= (1 + uuu.Mood);

        dbg(0, 17, "ふっくら使用中 = " + (fFkr ? "〇" : "×"));
        dbg(0, 18, "値はふっくら？ = " + (isFkr ? "〇" : "×"));

        if (fFkr)
        {   
            // 現在値が影響するのはこの5種類
            if (isFkr
                && false
                )
            {
                // 値をふっくらを加算した値として扱う
                Insp = InspRaw + Fkr;
                Gaman = GamanRaw + Fkr;
                Gaman_p = GamanRaw_p + Fkr;
                Gaman_Limit = GamanRaw_Limit + Fkr;
                Gaman_Limit_p = GamanRaw_Limit_p + Fkr;

                InspFkr = Insp;
                GamanFkr = Gaman;
                GamanFkr_p = Gaman_p;
                GamanFkr_Limit = Gaman_Limit;
                GamanFkr_Limit_p = Gaman_Limit_p;
            }
            else if (!isFkr) 
            {
                // 値を生の値として扱い、これにふっくらを足して補正する
                InspFkr = Insp + Fkr;
                GamanFkr = Gaman + Fkr;
                GamanFkr_p = Gaman_p + Fkr;
                GamanFkr_Limit = Gaman_Limit + Fkr;
                GamanFkr_Limit_p = Gaman_Limit_p + Fkr;

                InspRaw = Insp;
                GamanRaw = Gaman;
                GamanRaw_p = Gaman_p;
                GamanRaw_Limit = Gaman_Limit;
                GamanRaw_Limit_p = Gaman_Limit_p;
            }
        }
        else
        {
            // それらはフラグが無ければ通常の値として運用される
            InspFkr = Insp;
            GamanFkr = Gaman;
            GamanFkr_p = Gaman_p;
            GamanFkr_Limit = Gaman_Limit;
            GamanFkr_Limit_p = Gaman_Limit_p;
        }

        if (Insp > 10)
        {
            // 異常な数字が出た場合は強制トレースモード
            uuu.ModeTrace = true;
        }


        if (true
            // && false
            )
        {
            double UpFkr = Fkr - PreFkr;

            // ふっくら値の上昇分
            // インスピを変化させる
            if (UpFkr > 0)
            {
                Insp += UpFkr;
            }

            if (UpFkr < 0)
            {
                Insp += UpFkr;
                if (Insp < 0)
                {
                    double d = -Insp;
                    Insp = 0;
                    DownInsp(d);
                }
            }

            if (Insp > 10)
            {
                // 強制停止
                uuu.ModeTrace = true;
            }

            PreFkr = Fkr;
        }
    }
    void UpdateBakuhatuParam()
    {
        if (bkht == null)
        {
            bkht = new(un); 
        }

        bkht.Update();

#if b56
        //***********************************************************************
        //***********************************************************************
        //***********************************************************************
        //***********************************************************************
        //***********************************************************************
        //***********************************************************************
        // バクハツ状態
        //
        // ■こみあげ
        // バクハツの第一段階
        // インスピ限界超過時（ふんばり状態）
        // こみあげ値がインスピ限界超過に応じて、特定の割合まで増加する（たとえば30%など）
        // この「こみあげ値」がバクハツを通じて、生産される総量となる
        // （仕様変更の可能性あり）
        //
        // ■ふんばり
        // うにおんはこみあげるとこみあげたものをふんばって生産をしようとする
        // 「こみあげ値」が増加するとふんばり値が増加して
        // 「こみあげ値」のうち、さらに特定の割合で生産を行おうとする
        // これを脈動的に繰り返して、すこしずつこみ上げたものを吐き出して生産を行う
        // インスピ超過量が高い場合、「こみあげ値」の割合と「ふんばり値」の割合が増加して
        // より少ない回数で、大きな生産物をひとかたまりで一気に生産する
        //
        // ■うまれる
        // うまれる値は一定の時間でふんばり値と同じ値に達して
        // うまれる値と同じインスピ値を持つ生産物を吐き出す
        // 一定の時間で脈動するように生産させるために
        // どっくん値は規則的にふんばり値に達するように増加する

        //***********************************************************************
        //***********************************************************************

        double _InspVolume = InspVolume();
        double iv = _InspVolume;
        double tr = iv;           // トリガー値（現在インスピ質量）

        //Insp_Ratio = (Insp + Tamaran) / (Insp_Limit + Tamaran);     // インスピ率
        //Insp_Over = (Insp > Insp_Limit) ? (Insp + Tamaran - Insp_Limit) / (Insp_Limit + Tamaran) : 0;   // インスピ超過率
        Insp_Ratio = (tr) / Insp_Limit;     // インスピ率
        Insp_Over = (tr > Insp_Limit) ? (tr - Insp_Limit) / (Insp_Limit) : 0;   // インスピ超過率
        Tamaran_Ratio = (Tamaran) / Insp_Limit;  // たまらん率
        Tamaran_Over = (Tamaran > Insp_Limit) ? (Tamaran - Insp_Limit) / (Insp_Limit) : 0;   // たまらん超過率

        // ■こみあげ
        // 溜まっていないものはこみ上げようがない
        // インスピが生産限界だが、そこからさらにがまん値が限界値を絞る
        Komiage_Limit = Insp;
        //Komiage *= 1.0f - 0.1f * dTime;
        //Komiage -= 0.1f * dTime;
        Komiage *= 1.0f - 0.05f * dTime;
        Komiage -= 0.05f * dTime;
        MaxKomiageRate *= 1 - 0.025 * KomiageCr() * dTime;        // すっきりと同じ速度でこみ上げ最大値が減る
        Sukkiri *= 1 - 0.025 * KomiageCr() * dTime;             　// 少しでもこみ上げたらすっきりが直らない

        Funbari *= 1.0f - 0.1f * dTime;
        if (Komiage < 0.000001) Komiage = 0;
        if (Funbari < 0.000001) Funbari = 0;

        // ■たまらんミックス
        // 当初ミクスチャ量によってUpdateInspLimit()内でインスピ許容値が下がる仕様だった
        // 現在インスピ値に対して補正値をかけてバクハツしやすくしている
        // またこみあげ値の上昇でさらに補正値がつき、歯止めが利かなくなる
        // （最大インスピ限界の20%）
        TamaranMix =
            EasyMath.ConvTo(dMix, Gaman * 0.99, Gaman * 0.2)  // ミクスチャがたまらん率
                                                              // ミクスチャによって「たまらん」状態になり、インスピに補正値がかかる
            * Gaman / Gaman_Limit                             // がまん（色づき状態）によって補正がかかる                                                                            
            ;

        // ■たまらんインスピ
        // こみあげるとインスピ補正値が下がらなくなり
        // 生産してもすぐにはたまらん値が下がらなくなる
        Tamaran_Insp *= 1.0f - 0.1f * Mathf.Pow(1 - (float)(Haki_Komi / Iroduki_Limit), 5) * dTime;
        if (Tamaran_Insp < tr) Tamaran_Insp += (tr - Tamaran_Insp) * 5.0f * dTime;

        // たまらんＡ値へのがまん補正
        // 色づきが高ければ高いほど、たまらん値への影響が大きくなる
        double Tamaran_GamanCr = Mathf.Pow((float)(Gaman / Gaman_Limit), 3);
        double tg = Tamaran_GamanCr;                                        // 以下tg値

        // 一度こみあげたら、追加補正がかかり……たまらん、もうガマン出来ない！！
        Tamaran_A +=
            (Gaman) *
            (Haki_Komi / Gaman_Limit) * 2.0f * tg * dTime 　　　　　   // こみあげ補正
            + Haki * (Haki_Komi / Gaman_Limit) * 10.0f * tg * dTime　  // はきだし補正
            ;

        Tamaran_A *= 1 - 0.1 * dTime;

        //double _Tamaran;
        //_Tamaran = Tamaran_Insp
        //    + TamaranMix 
        //    + Haki * (Haki_Komi / Insp_Limit) * 5
        //    // 一度こみあげたら、追加補正がかかり……たまらん、もうガマン出来ない！！
        //    //+ (Insp_Limit_Base2) * (Komiage / Iroduki_Limit);
        //    + (Insp_Limit) * (Haki_Komi / Insp_Limit) * 2;

        Tamaran = Tamaran_Insp + TamaranMix + Tamaran_A;

        //Tamaran += (_Tamaran - Tamaran) * dTime * 1.0f;

        //Tamaran = TamaranMix * (Komiage / Iroduki_Limit);        // 一度こみあげたらもうガマン出来ない

        if (Union.TestCode == "Manjutane")
        {
            //Tamaran = 0;
        }

        

        // dProduct *= 0.99;

        // ふんばり値についてのメモ
        // インスピ限界に対して
        // インスピ（たまらん）が2倍の値で 50% のふんばり
        // ex) インスピ200/100の場合、(200-100) / 200 = 50%
        // 4倍の値で 75% のふんばり
        // ex) インスピ400/100の場合、(400-100) / 400 = 75%
        // 10倍で 90%
        // ex) インスピ1000/100の場合、(1000-100) / 1000 = 90%
        // 1.5倍で 33% くらい

        // b50
        // インスピ値と色づき値が実質統一された仕様変更に伴って
        // インスピ超過が従来の1割程度になっているので
        // ふんばり値をそれに合わせて修正するべきか
        // 超過20%で50%
        // // ex) インスピ120/100の場合、(120-100) / 120 = 50%
        // 120の部分を200にするために、100を引いて10をかける
        // 超過40%で75%
        // 超過100%で90%
        // ……どうだろうか？

        // b42
        // ふんばりに溜めを作るために
        // ふんばりとこみあげの目標値をずらす
        // ふんばりの値の方が初期は低めになり、後期は速めになる
        // これにより、初期のどっくんが遅延して
        // 十分にこみあげ値を上げることが目的
        //double Funbari_Goal = (iv) * (Komiage / (Iroduki_Limit + 0.01f)) * (Haki_Komi_b / (Iroduki_Limit + 0.01f));
        //double Dokkun_Goal = (iv) * (Haki_Komi / (Iroduki_Limit + 0.01f)) * (Komiage / (Iroduki_Limit + 0.01f));
        //double Funbari_Goal = (Insp) * (Komiage / (Iroduki_Limit + 0.01f)) * (Haki_Komi_b / (Iroduki_Limit + 0.01f));
        //double Dokkun_Goal = (Insp) * (Haki_Komi / (Iroduki_Limit + 0.01f)) * (Komiage / (Iroduki_Limit + 0.01f));
        //double Funbari_Goal = (iv) * (Komiage / (Insp + 0.01f)) * (Haki_Komi_b / (Insp + 0.01f));
        //double Dokkun_Goal = (iv) * (Haki_Komi / (Insp + 0.01f)) * (Komiage / (Insp + 0.01f));

        //double Funbari_Goal = (insp) * (Komiage / (Insp_Limit + 0.01f)) * (Haki_Komi_b / (Insp_Limit + 0.01f));
        //double Dokkun_Goal = (insp) * (Haki_Komi / (Insp_Limit + 0.01f)) * (Komiage / (Insp_Limit + 0.01f));

        //double Funbari_Goal = (Insp) * (Haki_Komi / (Insp_Limit + 0.01f));

        // ふんばり率（インスピに対してこみ上げた割合（ほぼこみあげ率））
        Funbari_Rate = Haki_Komi / (Insp + 0.01f);
        //Funbari_Rate = Komiage / (Insp + 0.01f);
        if (Funbari_Rate < 0) Funbari_Rate = 0;
        if (Funbari_Rate > 1) Funbari_Rate = 1;

        // 未生産のこみあげ値
        double fg_a;
        if (Haki_Komi > Haki_Komi_b) fg_a = Haki_Komi_b;
        else fg_a = Haki_Komi;

        // 調整とマイナスインスピ実装に伴って不要
        // if (fg_a > Insp + 0.01f) fg_a = Insp + 0.01f; 

        double fg_b = fg_a * Funbari_Rate;                              　// 未生産のこみあげ値に対して、1脈動で吐き出す値
        // double fg_a = (Haki_Komi_b) * Funbari_Rate;                   // 未生産のこみあげ値に対して、1脈動で吐き出す値
        // double Funbari_Goal = (Insp) * (Haki_Komi / (Insp_Limit + 0.01f)) * (Haki_Komi_b / (Insp_Limit + 0.01f));
        double Funbari_Goal = fg_b + 0.0001f;
        double Dokkun_Goal = (Insp) * (Haki_Komi / (Insp_Limit + 0.01f)) * (Komiage / (Insp_Limit + 0.01f));
        // 色づき中のこみあげ量が、これから生産したい量
        // そのうち、さらにこみあげの量だけ生産量を決定する
        // すでに吐き出した量は差し引いて計算する
        Haki_Komi_b += (Haki_Komi - Haki_Komi_b) * 0.5f * dTime;
        if (true)
        {
            if (Haki_Komi > 0.0001f ||
               (Tamaran > Insp_Limit && Insp > 0.01f))
            //if (Tamaran > Insp_Limit && Insp > 0.01f)
            {
                //double _Komiage;

                // b50版
                // double Komiage_Rate;     // インスピに対するこみ上げの割合
                // インスピ超過によってこの割合が変化する
                // 20%超過で50%、40%超過で75%、100%超過で90%
                // 逆数的な割合になってる

                //double t = 0.1f;
                double t = 1.0;                         // しきい値（10%だと10%超えで50%に、100%だと100%超えで50%）

                double a = Tamaran - Insp_Limit;        // インスピ超過量
                double b = a / Insp_Limit;              // インスピ超過率（たとえば10%）

                b = b + t;
                // b = b + 0.1f;                        // しきい値10%の時
                // 超過率10%以下でレートマイナス化を防ぐために
                // 超過率に10%補正をかける（10%→20%になる）

                double bt = b * (1.0f / t);
                //double b10 = b * 10;                  // しきい値10%の時に10倍化（20%→2になる）
                // つまり、逆数をかける

                Komiage_Rate = (bt - 1) / bt;
                //Komiage_Rate = (b10 - 1) / b10;       // しきい値10%の時
                // 10%の場合  : 2 - 1 / 2 = 50%
                // 30%の場合  : 4 - 1 / 4 = 75%
                // 90%の場合  : 10 - 1 / 10 = 90%
                // 0%の場合   : 1 - 1 / 1 = 0%

                // こみ上げは0以上、1以下
                if (Komiage_Rate < 0) Komiage_Rate = 0;
                if (Komiage_Rate > 1) Komiage_Rate = 1;

                Komiage = Komiage_Rate * Insp;          // インスピのうち、この割合を「こみあげ」で生産する
                //Komiage_b = Komiage_Rate * Insp;      // インスピのうち、この割合を「こみあげ」で生産する

                //if (Komiage_b > Komiage) Komiage = Komiage_b;
                //Komiage *= 1.0f - 0.001f * dTime;

                // b49まで
                //Komiage = ((Tamaran - Insp_Limit) / Tamaran) * Insp;
                //Komiage = ((Tamaran - Insp_Limit) / Tamaran) * Iroduki_Limit;

                //Komiage += (_Komiage - Komiage) * dTime * 1.0f;

                if (Komiage_Rate > MaxKomiageRate) MaxKomiageRate = Komiage_Rate;     // こみあげ最大値更新
                /*if (Score < MaxKomiageRate * 100
                    && Komiage > 0.0001f
                    && Haki_Komi > 0.0001f)
                { 
                    Score = MaxKomiageRate * 100;       // スコア更新
                }*/
            }
            else
            {
                // Komiage = 0;
            }

            // こみ上げたものは最後まで吐き出すようにするために
            // こみあげ値の低下で0にならないようにする
            // 増える時だけ適用する
            UpdateHakikomi();

            if (Funbari < 0) Funbari = 0;
            if (Haki_Komi > 0)
            {
                Funbari +=
                    (Funbari_Goal - Funbari)
                    * 0.5f * dTime;
            }
            if (Funbari > Funbari_Goal) Funbari = Funbari_Goal;
            //if (Funbari > Mathf.Pow((float)Komiage, 2) / Insp_Limit) Funbari = 0;

            if (Umareru < 0) Umareru = 0;
            if (Funbari > 0)
            {
                // 2秒で踏ん張りの値と等価になる計算
                Umareru += Funbari * 0.5f * dTime;
            }
            //if (Funbari > Mathf.Pow((float)Komiage, 2) / Insp_Limit) Funbari = Mathf.Pow((float)Komiage, 2) / Insp_Limit;
            /*if (Dokkun > Funbari_Goal)
            {
                Haki += Dokkun;
                Dokkun = 0;
                Funbari = 0;
            }*/

            //Haki *= 1 - 0.01f * dTime;
            Haki *= 1 - 0.025 * KomiageCr() * dTime;             // こみあげ中ははきだし値が減らない
            Haki_Rate *= 1 - 0.025 * KomiageCr() * dTime;        // こみあげ中ははきだし値が減らない
            //if (Haki > Komiage) Haki = Komiage;

            //Umareru = Dokkun;       // うまれる値（順次どっくん値から以降）

            // バクハツ後にうまれた値がゴミとして残るので処理
            if (Insp_Rate(Tamaran) < 1.0f)
            {
                //Umareta = 0;
                Umareta *= 1 - 0.01f * dTime;
                Umareta -= 0.0001f * dTime;
                if (Umareta < 0) Umareta = 0;
            }
        }

        // b41
        if (false)
        {
            if (Tamaran > Insp_Limit && Komiage_Limit > 0)
            {
                // （×）こみ上げ値は色づき（Iroduki = Komiage_limit）以上は上がらない

                // こみあげ値の上限は色づきとインスピ値
                // こみあげ限界は実質の生産上限となっており
                // 現在の仕様ではためこみ値から生産出来る値を、色づき値が決める
                // こみあげ限界値は、現在色づき値と同値
                // こみ上げ用係数
                // インスピ限界を超えた場合のこみあげ量を決める係数 (Komiage_Power = 0.005f)
                Komiage += ((Tamaran - Insp_Limit) * Komiage_Power)
                    * (1.0f - Komiage / Komiage_Limit)
                    * 50.0f * dTime;

                if (Komiage > MaxKomiage) MaxKomiage = Komiage;     // こみあげ最大値更新

                // こみあげた量によってインスピ許容値が下がる
                /*if (Tamaran / Insp_Limit_Base < Komiage / (Iroduki_Limit + Insp + 0.01f))
                {
                    Tamaran += ((Komiage * (Insp_Limit_Base / (Iroduki_Limit + Insp + 0.01f)))
                        - Tamaran) * 0.05;
                    if (Tamaran > Insp_Limit_Base * 0.99) Tamaran = Insp_Limit_Base * 0.99;
                       // * 0.01f;
                }*/


            }
            //Insp_Limit = Insp_Limit_Base - Tamaran;
            //Iroduki_Limit = Iroduki_Limit_Base - Tamaran;
            Tamaran *= 1 - (0.005 * dTime) * Sukkiri_Invalid_Rate_B(1, 1);
            // 0.9999 + 0.0001 * Sukkiri_Rate();

            //if (Komiage > Komiage_Limit) Komiage = Komiage_Limit;
            if (Komiage > Iroduki)
            {
                Komiage = Iroduki;
            }
            if (Komiage < 0) Komiage = 0;

            //Funbari += ((Insp - Insp_Limit) / 1000) * ((Komiage - dProduct) / Komiage_Limit);
            // インスピがあるから踏ん張る？
            // こみあげるから踏ん張る？
            // しっかりミクスチャすれば、しっかり踏ん張って十分な生産が出来る
            if (Komiage > 0)
            {
                if (Funbari < 0) Funbari = 0;
                //Funbari += ((Insp - Insp_Limit) / 1000f) * ((Komiage - dProduct) / (Komiage_Limit + 0.1f)) * (1.0f - Funbari / (Komiage + 0.1f));
                //Funbari += ((Komiage - dProduct) / (Komiage_Limit + 0.0f)) * 0.1f * (1.0f - Funbari / (Komiage + 0.0f));
                // 0.015 ?
                //Funbari += ((Komiage - dProduct) / (Komiage_Limit + 0.001f)) * (0.015f + (Insp_Ratio * 0.000f)) * Mathf.Pow((float)(1.0f - Mathf.Abs((float)Funbari) / (Komiage + 0.001f)), 1.5f);

                // ふんばり値
                // こみあげた場合、その量に応じてふんばり値が増加する
                // ふんばった分だけどっくん値が増加して、バクハツの引き金になる
                // どっくん値に達するまでの間、どれだけ踏ん張るかで生産物の大きさが決まる
                // ふんばり用係数
                // こみあげた場合のふんばり量が増加する係数 (Funbari_Power = 0.015f)
                // こみあげた場合、インスピ量によるふんばり増加ボーナス（Funbari_InspBonus = 0.000f）
                // ふんばりが高すぎてこみあげが枯渇してしまうのを防ぐ係数
                // こみあげに対するふんばり量を出来るだけ 1.0 から遠さげる乗数 (FunbarisugiPenaltyPow = 3.0f)
                Funbari += ((Komiage - dProduct) / (Komiage_Limit + 0.001f))
                    * (Funbari_Power + (Tamaran_Ratio * Funbari_InspBonus))
                    * Mathf.Pow(Mathf.Abs((float)(1.0f - Funbari / (Komiage + 0.001f))), FunbarisugiPenaltyPow)
                    * 50.0f * dTime;

                // こみあげ限界値ボーナス
                // こみあげ量がインスピ限界値に近づくと、ふんばりも連鎖的にインスピ限界値に近づくボーナスが発生
                // これにより大きな生産物を作ることが出来る
                // ふんばり用係数２
                // こみあげがどれだけ色づき限界値に近づく必要があるかを決める乗数 (Funbari_KomiageBonusPow = 5.0f)
                // このボーナスのインスピ量による増加ボーナス (Funbari_KomiageBonusInspBonus = 0.02f)
                Funbari += ((Komiage - dProduct) - (Funbari - dProduct))
                    * Mathf.Pow((float)(Komiage / Insp_Limit + 0.001f), Funbari_KomiageBonusPow) * (Tamaran_Ratio * Funbari_KomiageBonusInspBonus) // こみあげ限界値ボーナス
                    * 50.0f * dTime;
            }
            if (Funbari > Komiage) Funbari = Komiage;
            if (Funbari < 0) Funbari = 0;

            if (Funbari > 0)
            {
                //Dokkun += EasyMath.ConvTo((0.5f + (Insp / Insp_Limit) * 0.5f) * (Funbari - dProduct), 2.0f, 100);
                //Dokkun += EasyMath.ConvTo((Komiage - dProduct), 0.05f, 100);

                // どっくん値
                // 
                // ふんばりがインスピ限界値に近づくと、脈動に大きな溜めが入る
                // どっくん値用係数
                // ふんばった場合の脈動が速くなる係数 (Dokkun_Power = 0.075f)
                // ふんばり中の、インスピ値超過量によるどっくん値増加ボーナス（Dokkun_InspOverBonus = 0.000f）
                // どれだけインスピ限界値に近づく必要があるかを決める乗数 (Dokkun_FunbariBonusPow = 5.0f)
                // 0.05?
                Umareru += (Funbari - dProduct)
                    //* (Dokkun_Power - (Insp_Over * Dokkun_FunbariInspOverBonus))
                    //* (Mathf.Pow(Mathf.Abs((float)(1.0f - Funbari / Insp_Limit_Base)), Dokkun_FunbariBonusPow) + 0.02f)　 // ふんばり限界値ボーナス
                    * (Dokkun_Power - (Insp_Over * Dokkun_KomiageInspOverBonus))
                    * (Mathf.Pow(Mathf.Abs((float)(1.0f - Komiage / Insp_Limit)), Dokkun_KomiageBonusPow) + 0.05f)　// こみあげ限界値ボーナス
                    * Mathf.Pow(Sukkiri_Invalid_Rate_B(1, 1), 5.0f)                                                          // すっきり値ペナルティ
                    * 50.0f * dTime;
            }
        }
        //if (Dokkun < 0) Dokkun = 0;

        // 色づきポンプ（色づきからインスピに値が送られる）
        // double IrodukiPump = 0;
        /*double IrodukiPump = Komiage
            * (Iroduki / Iroduki_Limit)
            * (1 - Sukkiri_Rate())
            * 0.05f;*/
        //double IrodukiAntiPump = 0;
        /*double IrodukiAntiPump = Komiage
            * (Insp - Insp_Limit)
            * 0.01
            * Sukkiri_Rate();*/

        /*Komiage
        * ((Insp - Insp_Limit) * 10 - Iroduki) / Iroduki_Limit)

        * 0.01f;*/
        //Insp += IrodukiPump - IrodukiAntiPump;     // こみ上げたら歯止めが利かなくなる
        //Iroduki -= IrodukiPump - IrodukiAntiPump;
        //Insp += Funbari * 0.05f; // こみ上げたら歯止めが利かなくなる
        //if (Komiage >= 1.0f && (Funbari - dProduct) > Komiage)  // 完成
        //if (Funbari > 0 && Komiage > 0 && Dokkun > Komiage)  // 完成
        //if (Dokkun > Dokkun_Goal)
        if (Umareru > Funbari)
        {
            Kansei();
        }

        // スコア表示
        if (Komiage < 0.00001f && Score != 0)
        {
            // スコアが100以外では通常表示
            // 100の場合はインスピ超過が無くなるのを待つ
            if (Score != 100 ||
                (Score == 100 && Tamaran_Over == 0))
            {
                Union.Result((int)(Score));
                Score = 0;
            }
        }
#endif
    }

    public void UpdateHakikomi()
    {
        //********************************************************
        // ここの計算に際し
        // バクハツ中にさらにインスピが追加されてしまった場合は？
        //********************************************************
        // ・(1 - Haki_Rate)
        // つまり吐いた残りが現在のInsp量
        //
        // ・a = (MaxKomiageRate - Haki_Rate)
        // 吐き切れていない確率
        //
        // ・b = a /（1 - Haki_rate）
        // 残った確率に対する、吐き切れていない確率の割合
        double a = (MaxKomiageRate - Haki_Rate);
        double b = 0;

        // 吐き出し率が100を超えたら、b = 0
        if (1 - Haki_Rate > 0.01f)
        {
            b = a / (1 - Haki_Rate);
        }

        if (Haki_Komi < Insp * b)
        {
            Haki_Komi = Insp * b;
            // はきこみ値は確実に吐き出すまで収束しない
        }
        //if (Haki > Komiage)
        //{
        //    Haki_Komi = 0;
        //}

        // 少量のはきこみを0に収束させる
        Haki_Komi -= 0.001f * dTime;
        if (Haki_Komi < 0) Haki_Komi = 0;
    }

    void UpdateInsp()
    {
        if (uuu.TestCode == "Kurimanju")
        {
            // インスピ増加量
            double UpInsp = ddMixSukkiri;

            // 最終的にインスピ増加した後
            // 各チャンネルにインスピを分配する形がいいか？
            // だから直接チャンネルにUpInspを追加しない感じとか
            if (InspMinus > 0)
            {
                // b56からマイナスインスピを直接減らす仕様を無くし
                // インスピから自然吸収する形に変更する
                if (mInspMinus == "absorb")  // すこしずつ吸収
                {
                    Insp += UpInsp;
                    if (Insp > 0)
                    {
                        // マイナスインスピ吸収率1%
                        //double _DownInsp = (InspMinus * 0.01f) * dTime;
                        //double _DownInsp = (InspMinus * 0.1f) * dTime;
                        float r = Mathf.Clamp(Gaman_Rate(), 0.1f, 1);
                        
                        double _DownInsp = (InspMinus * 1.0f) * r * dTime;
                        DownInsp(_DownInsp);
                        InspMinus -= _DownInsp;
                        dbg(0, 13, "_DownInsp = " + _DownInsp.ToString("F8"));
                        if (Insp < 0)
                        {
                            InspMinus += -Insp;
                            Insp = 0;
                        }
                    }
                }

                if (mInspMinus == "minus")  // ただのマイナス値扱い
                {
                    InspMinus -= UpInsp;
                    if (InspMinus < 0)
                    {
                        InspMinus = 0;
                        Insp += -InspMinus;
                    }
                }
            }
            else if (InspMinus < 0)
            {
                // InspMinusがマイナスの場合
                // インスピに上昇補正がかかっている
                // バクハツ時の仕様
                Insp += UpInsp;
                double UpInsp2 = Insp * 0.01f * (-InspMinus) * 0.01f * dTime;
                Insp -= UpInsp2;
                InspMinus += UpInsp2;

            }
            else
            {
                Insp += UpInsp;
            }

            // 色気づきから秒間0.01%ずつ増加
            /*
            if (Irk > 0)
            {
                Insp += Irk * 0.0001 * dTime;
                Irk -= Irk * 0.0001 * dTime;
            }*/

            // dUpInsp & 子ポップ生成は一時停止
            // dUpInsp += UpInsp / Iroduki_Capacity;
            // 色づき単位でどの程度のインスピを送り込んでいるか？
            // 子ポップ生成用

            while (false && dUpInsp > 0.1f)
            {
                // 湧かせる
                _Iroduki_ChildPop NewChildPop = new();
                NewChildPop.obj = Instantiate(ICPop_0_1, new Vector3(0, 0, 0), Quaternion.identity, ui.ip.InspPopMaster.transform);
                NewChildPop.time = 5.0f;
                NewChildPop.posx = 0;
                NewChildPop.posy = 0;
                Random.InitState((int)System.DateTime.Now.Ticks);
                NewChildPop.posgx = Random.value * 3.0f - 1.5f;
                NewChildPop.posgy = Random.value * 3.0f - 1.50f;
                NewChildPop.obj.SetActive(true);
                //NewChildPop.obj.

                if (Iroduki_ChildPop == null)
                {
                    Iroduki_ChildPop = new List<_Iroduki_ChildPop>();
                }
                Iroduki_ChildPop.Add(NewChildPop);
                Iroduki_nChildPop++;

                /*GameObject NewProdPop;
                NewProdPop = Instantiate(ProdPopOrg, new Vector3(0, 0, 0), Quaternion.identity);
                NewProdPop.GetComponent<ProdPop>().Product = Producable();
                NewProdPop.GetComponent<ProdPop>().Sukkiri = a;
                NewProdPop.GetComponent<ProdPop>().Uni_Mxt = this;
                NewProdPop.GetComponent<ProdPop>().times = 1;               // 応急処置：timesが０だと表示時間なしと見なされて消去される？
                ProdPops.Add(NewProdPop);

                NewProduct = Instantiate(Prod_Syrup_Org, new Vector3(0, 0, 0), Quaternion.identity);
                NewProduct.GetComponent<Product>().Grade = (int)(b / 1);        // シロップの生産量は1の倍数
                }
                NewProduct.SetActive(false);
                NewProduct.GetComponent<Product>().Union = Union;
                NewProduct.GetComponent<Product>().Born_Pos = Union.transform.Find("Anim/Shadow_Pos").gameObject.transform.position.y;
                ProductFlavors.Add(NewProduct);
                Birth(b);*/

                //Iroduki_ChildPop.Add = new GameObject;

                dUpInsp -= 0.1f;
            }

            // インスピ0が50%でインスピ1が開通
            // 50% - 100%の範囲で倍率が 0 - 1 で変化
            /*if (Insp / Insp_Limit > 0.5) {
                float Insp1_Rate = (float)((Insp / Insp_Limit) - 0.5) * 2;
                if (Insp1_Rate > 1) Insp1_Rate = 1;
                Insp1 += UpInsp * Insp1_Rate;
            }
